@prefix aom: <urn:era-aom:schema:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:era-aom:schema> a owl:Ontology ;
  dcterms:title "AOM semantic model"@en ;
  dcterms:description "OWL model separating AOM knowledge-organization concepts from agricultural observations, feed-material records, quantities, and governance provenance."@en ;
  owl:versionInfo "design-1" .

aom:Module a owl:Class ; rdfs:label "module"@en .
aom:MappingAssertion a owl:Class ; rdfs:label "mapping assertion"@en .
aom:ChangeProposal a owl:Class ; rdfs:label "change proposal"@en .
aom:Release a owl:Class ; rdfs:label "release"@en .
aom:Evidence a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "evidence"@en .
aom:Reviewer a owl:Class ; rdfs:subClassOf prov:Agent ; rdfs:label "reviewer"@en .
aom:SemanticBinding a owl:Class ;
  rdfs:label "semantic binding"@en ;
  rdfs:comment "Governed migration contract connecting a legacy AOM concept to its normalized data-model use."@en .
aom:SemanticValueBinding a owl:Class ;
  rdfs:label "semantic value binding"@en ;
  rdfs:comment "Governed decision mapping a source controlled value to an ontology concept or explicitly holding it unresolved."@en .

aom:FeedMaterial a owl:Class ;
  rdfs:label "feed material"@en ;
  rdfs:comment "A material used or evaluated as feed. Source organism, part, processing method, and economic product role are modeled as facets."@en .
aom:FeedFormulation a owl:Class ; rdfs:label "feed formulation"@en .
aom:IngredientComponent a owl:Class ;
  rdfs:label "ingredient component"@en ;
  rdfs:comment "A feed material used in a formulation, optionally with a quantitative proportion."@en .
aom:QuantitativeObservation a owl:Class ;
  rdfs:subClassOf sosa:Observation ;
  rdfs:label "quantitative observation"@en .
aom:ProductRole a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "product role"@en .
aom:IngredientPartCategory a owl:Class ;
  rdfs:subClassOf aom:FeedMaterialComponent ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "ingredient part category"@en .
aom:FeedMaterialComponent a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "feed material component"@en ;
  rdfs:comment "Reviewed material scope or component, including anatomical parts and collective material such as a whole crop."@en .
aom:IngredientPhysicalForm a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "ingredient physical form"@en .
aom:MaterialIntegrity a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "material integrity"@en ;
  rdfs:comment "Compositional integrity retained by a material independently of particle form or processing."@en .
aom:ProcessingMethod a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "processing method"@en .
aom:IngredientConstituent a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "ingredient constituent"@en .
aom:ParityStatus a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "parity status"@en .
aom:GestationalStage a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "gestational stage"@en .
aom:IngredientSourceCategory a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "ingredient source category"@en .

aom:inModule a owl:ObjectProperty ; rdfs:range aom:Module .
aom:supportedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:range aom:Evidence .
aom:reviewedBy a owl:ObjectProperty ; rdfs:range aom:Reviewer .
aom:releasedIn a owl:ObjectProperty ; rdfs:range aom:Release .
aom:hasIngredientComponent a owl:ObjectProperty ;
  rdfs:domain aom:FeedFormulation ; rdfs:range aom:IngredientComponent .
aom:ingredientMaterial a owl:ObjectProperty ;
  rdfs:domain aom:IngredientComponent ; rdfs:range aom:FeedMaterial .
aom:ingredientProportion a owl:ObjectProperty ;
  rdfs:domain aom:IngredientComponent ; rdfs:range qudt:QuantityValue .
aom:sourceTaxon a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ;
  rdfs:comment "Links feed material to a reviewed taxon IRI; does not imply SKOS identity."@en .
aom:materialComponent a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:FeedMaterialComponent .
aom:ingredientPart a owl:ObjectProperty ;
  rdfs:subPropertyOf aom:materialComponent ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:IngredientPartCategory .
aom:physicalForm a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:IngredientPhysicalForm .
aom:materialIntegrity a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:MaterialIntegrity .
aom:processingMethod a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:ProcessingMethod .
aom:productRole a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:ProductRole .
aom:ingredientConstituent a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:IngredientConstituent .
aom:ingredientSource a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:IngredientSourceCategory .
aom:ingredientName a owl:DatatypeProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range xsd:string .
aom:legacyComponentDescriptor a owl:DatatypeProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range xsd:string ;
  rdfs:comment "Unmodified legacy component descriptor retained until reviewed decomposition into explicit facets."@en .

aom:legacyConcept a owl:ObjectProperty ;
  rdfs:domain aom:SemanticBinding ; rdfs:range skos:Concept .
aom:targetClass a owl:ObjectProperty ; rdfs:domain aom:SemanticBinding .
aom:targetProperty a owl:ObjectProperty ; rdfs:domain aom:SemanticBinding .
aom:valueClass a owl:ObjectProperty ; rdfs:domain aom:SemanticBinding .
aom:quantityKind a owl:ObjectProperty ; rdfs:domain aom:SemanticBinding .
aom:bindingKind a owl:DatatypeProperty ; rdfs:domain aom:SemanticBinding ; rdfs:range xsd:string .
aom:unitRequirement a owl:DatatypeProperty ; rdfs:domain aom:SemanticBinding ; rdfs:range xsd:string .
aom:compatibilityPolicy a owl:DatatypeProperty ; rdfs:domain aom:SemanticBinding ; rdfs:range xsd:string .
aom:bindingStatus a owl:DatatypeProperty ; rdfs:domain aom:SemanticBinding ; rdfs:range xsd:string .
aom:valueTargetProperty a owl:ObjectProperty ; rdfs:domain aom:SemanticValueBinding .
aom:valueTargetConcept a owl:ObjectProperty ;
  rdfs:domain aom:SemanticValueBinding ; rdfs:range skos:Concept .
aom:targetValueClass a owl:ObjectProperty ; rdfs:domain aom:SemanticValueBinding .
aom:sourceValue a owl:DatatypeProperty ;
  rdfs:domain aom:SemanticValueBinding ; rdfs:range xsd:string .
aom:bindingAction a owl:DatatypeProperty ;
  rdfs:domain aom:SemanticValueBinding ; rdfs:range xsd:string .
aom:valueBindingStatus a owl:DatatypeProperty ;
  rdfs:domain aom:SemanticValueBinding ; rdfs:range xsd:string .
