    {
      "@id": "urn:era-aom:livestock:AOM_003000",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003000",
      "skos:prefLabel": {
        "@value": "Layer",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A layer chicken is a type of poultry that is raised specifically for egg production. These chickens are may be kept in large commercial facilities and are fed a specialized diet to optimize egg production.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000025"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003001",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003001",
      "skos:prefLabel": {
        "@value": "Dual purpose",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A taxonomic concept used in AOM to identify Dual purpose within the Chicken classification.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000025"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003002",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003002",
      "skos:prefLabel": {
        "@value": "Broiler",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Broiler chickens are raised commercially for their meat and will grow to be 3-6 pounds by 8 weeks of age but tend to be afflicted by health problems related to this fast growth, including skeletal weakness, congestive heart failure, and a decrease in fertility. Derived from a cross between a white cornish male and a barred rock female in the 1930s, modern broilers are an F2 hybrid of broiler breeds characterized by high fecundity and fast growth.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000025"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/FOODON_03411198"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003003",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003003",
      "skos:prefLabel": {
        "@value": "Feed Addition",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A livestock-management concept concerning Feed Addition within Feed Management.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000108"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003004",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003004",
      "skos:prefLabel": {
        "@value": "Product",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Feeds added to animal diets that come from non-woody crops usually grown for human consumption. These can be crop grain, field residues (for example maize stalks left over once the grain component has been harvested), or processing residues (for example the maize bran produced as a byproduct of milling flour). Soyabeans fit in this category as they are grown for human consumption and livestock feed.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_003014"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003005",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003005",
      "skos:prefLabel": {
        "@value": "Non Crop Fodders",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Feeds added to animal diets that are derived from non-woody crops grown primarily to feed to animals (e.g., alfafa or clover grown to feed to cattle) or non-woody plants harvested from non-cropped areas (e.g., forage grasses such as napier grass grown to stabilize terraces, cactus harvested from boundary fences, wild growing plants in wayside or fallows, algae, etc.).",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_003003"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003006",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003006",
      "skos:prefLabel": {
        "@value": "Agroforestry Fodders",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Feeds added to animal diets that are from agroforestry shrub or tree fodders or other woody plants.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_003003"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003007",
