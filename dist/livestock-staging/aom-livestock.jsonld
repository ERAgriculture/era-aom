      ],
      "skos:definition": {
        "@value": "Koronivia grass (Brachiaria humidicola (Rendle) Schweick) is a tropical grass from East and South-East Africa and was introduced to Australia, the Pacific Islands and South America. It is an important pasture in the humid tropics (Cook et al., 2005; Schultze-Kraft et al., 1992). [Feedipedia]",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000058"
