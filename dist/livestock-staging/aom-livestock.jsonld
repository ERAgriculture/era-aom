          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Pangola grass (Digitaria eriantha Steud) is a tropical grass widespread in many humid tropical and subtropical regions, used extensively for grazing, hay and silage. It is often considered to be one of the higher quality tropical grasses (Cook et al., 2005). [Feedipedia]",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000058"
