        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000029",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000029",
      "skos:prefLabel": {
        "@value": "Guineafowl",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Helmeted Guineafowl",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Guineafowl are birds of the family Numididae in the order Galliformes. They are endemic to Africa and rank among the oldest of the gallinaceous birds",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000024"
      },
      "skos:relatedMatch": [
