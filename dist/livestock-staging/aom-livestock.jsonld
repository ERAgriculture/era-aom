    {
      "@id": "urn:era-aom:livestock:AOM_006824",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_006824",
      "skos:prefLabel": {
        "@value": "Fibrolytic Treatment",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A broad class of enzymes that catalyze the breakdown of complex fibrous components of plant cell walls, including cellulose, hemicellulose, and pectin. Fibrolytic enzymes include cellulases (which target cellulose), xylanases (which target hemicellulose), and other related hydrolases, and are critical in both natural and applied processes such as rumen digestion, silage treatment, and biomass degradation for biofuels.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000820"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_012120",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
