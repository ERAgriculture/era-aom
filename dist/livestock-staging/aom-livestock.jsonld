      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000270",
      "skos:prefLabel": {
        "@value": "Total Phenols",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Any measurable characteristic related to the sum of phenols (CHEBI:15882) in feed. Total phenols represent the collective amount of phenolic compounds, including tannins, present in animal feeds. Phenolic compounds are secondary metabolites in plants and may possess antioxidant properties. The total phenol content can influence the nutritional quality, palatability, and digestibility of feedstuffs, as well as potentially exerting various physiological effects on the animals consuming th",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000196"
      }
    },
