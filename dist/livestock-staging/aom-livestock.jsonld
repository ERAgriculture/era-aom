    {
      "@id": "urn:era-aom:livestock:AOM_003097",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003097",
      "skos:prefLabel": {
        "@value": "Decorticated",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Decortication is a mechanical process in which the outer hull, husk, or shell of seeds or grains is removed to reduce fiber content and improve the digestibility and nutritional quality of livestock feed. It is commonly applied to oilseeds such as cottonseed, groundnut, and sunflower before or after oil extraction.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000837"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003098",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003098",
      "skos:prefLabel": {
        "@value": "Sprouted",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A process in which grains or seeds are soaked and germinated under controlled moisture and temperature conditions to initiate sprouting. This enhances enzymatic activity, reduces anti-nutritional factors, and increases the bioavailability of certain nutrients, making the feed more digestible and nutritionally beneficial for livestock.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_100990"
      }
    },
