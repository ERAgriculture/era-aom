      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000117",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000117",
      "skos:prefLabel": {
        "@value": "Use of Tree Fodders",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "An experimental diet contains more fodders derived from trees than a control diet. This does not include the byproducts from processing tree crop products.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000109"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000118",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000118",
      "skos:prefLabel": {
        "@value": "Use of Insects",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "An experimental diet contains more fodders derived from insects than a control diet. This does not include the byproducts from processing insect products.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000109"
      }
    },
    {
