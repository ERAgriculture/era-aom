      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Fodder, a type of animal feed, is any agricultural foodstuff used specifically to feed domesticated livestock, such as cattle, rabbits, sheep, horses, chickens and pigs. \"Fodder\" refers particularly to food given to the animals (including plants cut and carried to them), rather than that which they forage for themselves (called forage).",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000055"
      },
