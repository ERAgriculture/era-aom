        "@value": "Alfalfa",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Lucerne",
          "@language": "en"
        },
        {
          "@value": "Medicago polia",
          "@language": "en"
        },
        {
          "@value": "Medicago praesativa",
