      "skos:definition": {
        "@value": "Feeds added to animal diets that are derived from animals, e.g. blood meal, fish meal, bone meal, fish oil, offals, etc.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_003003"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003009",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003009",
      "skos:prefLabel": {
        "@value": "Insect Fodders",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
