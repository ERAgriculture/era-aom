      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000368",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000368",
      "skos:prefLabel": {
        "@value": "Specific Growth Rate",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Specific Growth Rate (SGR) is typically measured as the change in body weight of an animal over a specified time period, divided by the number of days in that period. For example, if an animal weighed 100 kg at the beginning of a 30-day period and weighed 120 kg at the end of that period, the SGR would be calculated as follows: SGR = (120 kg - 100 kg) ÷ 30 days = 0.67 kg/day.  This indicates that the animal gained an average of 0.67 kg per day during the 30-day period.  (human validated chatGPT)",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000366"
      }
    },
