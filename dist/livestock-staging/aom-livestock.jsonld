        "@value": "Hairy Vetch",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Winter Vetch",
          "@language": "en"
        },
        {
          "@value": "Sand Vetch",
          "@language": "en"
        },
        {
          "@value": "Woolly-pod Vetch",
          "@language": "en"
        },
        {
          "@value": "Woolly Vetch",
          "@language": "en"
        },
        {
          "@value": "Cardyne Vetch",
          "@language": "en"
        },
        {
          "@value": "Corbière Hairy Vetch",
          "@language": "en"
        },
        {
          "@value": "Fodder Vetch",
          "@language": "en"
        },
        {
          "@value": "Lana Vetch",
          "@language": "en"
        },
        {
          "@value": "Smooth Vetch",
          "@language": "en"
        },
        {
          "@value": "Thick-fruited Vetch",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Hairy vetch (Vicia villosa Roth) is an annual or biannual viny legume with a woolly appearance due to long soft hairs borne on the stems and leaves (FAO, 2014; Cook et al., 2005; Undersander et al., 1990). It remains green longer than the common vetch (Vicia sativa). It flowers and Seed late in the season and often survives the dry season, regenerating to almost full strength during the next rainy season (Göhl, 1982). [Feedipedia]",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000059"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_3911"
        },
        {
          "@id": "https://www.feedipedia.org/node/12787"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000075",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000075",
      "skos:prefLabel": {
        "@value": "Ryegrass",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Lolium",
          "@language": "en"
        },
        {
          "@value": "Italian Ryegrass",
          "@language": "en"
        },
        {
          "@value": "Perennial Ryegrass",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "The most important cultivated temperate grasses. Also grown in subtropical areas of Australia, S America and S Africa; in the tropics, ryegrass is grown to a limited extent at high altitudes, e.g. in Colombia or Kenya, ryegrass is grown above 2400-2500 m alt. Often sown in mixtures with white clover. L. multiflorum is less persistent, dying out after 2-3 years of productive growth. It withstands drier and hotter conditions better than L. perenne and in the tropics it can be grown at somewhat lower altitudes than the latter. [Feedipedia]",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000058"
      },
