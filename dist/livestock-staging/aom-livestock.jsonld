          "@id": "http://opendata.inra.fr/EOL/EOL_0000164"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000242",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000242",
      "skos:prefLabel": {
        "@value": "Metabolizable Energy (ME)",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Metabolizable energy. Difference between the gross energy in the feed and the gross energy in the faeces, urines and gasses, not corrected for N retention. Source: Feedipedia",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000244"
      },
      "skos:relatedMatch": [
