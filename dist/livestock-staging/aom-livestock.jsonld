      },
      "skos:notation": "AOM_000260",
      "skos:prefLabel": {
        "@value": "Nitrogen Free Extracts (NFE)",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Nitrogen Free Extracts (NFE) is an estimate of the readily available carbohydrate content of animal feeds, calculated by subtracting the percentages of crude protein, crude fat, crude fiber, and ash from 100. NFE primarily includes sugars and starches, which provide energy for animal metabolism. (HV GPT4)",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000196"
      }
    },
