    {
      "@id": "urn:era-aom:livestock:AOM_003202",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003202",
      "skos:prefLabel": {
        "@value": "Molasses Treatment",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Molasses treatment involves applying molasses to fibrous feeds such as straw, stover, or hay to enhance palatability, increase energy content, and reduce dustiness. While it does not chemically alter fiber structure like alkali treatments, molasses provides readily fermentable carbohydrates that improve feed intake and support rumen microbial activity. It is often used as a carrier for urea or minerals in treated feeds and is widely adopted in both smallholder and commercial livestock systems for its ease of use and positive impact on voluntary intake.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_100991"
      }
    },
