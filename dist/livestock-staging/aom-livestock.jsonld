        "@value": "Animal",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A multicellular eukaryotic heterotrophic organism within the kingdom Animalia.",
