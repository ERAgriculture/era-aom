    {
      "@id": "urn:era-aom:livestock:AOM_000003",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000003",
      "skos:prefLabel": {
        "@value": "Terrestrial",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Land Animals",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "A terrestrial animal species is a group of animals that can interbreed and produce fertile offspring and predominantly inhabit the land.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000002"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000004",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000004",
      "skos:prefLabel": {
        "@value": "Mammal",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Mammals (from Latin mamma \"breast\") are vertebrate animals constituting the class Mammalia, and characterized by the presence of mammary glands which in females produce milk for feeding (nursing) their young, a neocortex (a region of the brain), fur or hair, and three middle ear bones.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000003"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/FOODON_03411134"
        },
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_40674"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000005",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000005",
      "skos:prefLabel": {
        "@value": "Bovine",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "The biological subfamily *Bovinae* includes a diverse group of 10 genera of medium- to large-sized ungulates, including domestic cattle, the bison, African buffalo, the water buffalo, the yak, and the four-horned and spiral-horned antelopes. The evolutionary relationship between the members of the group is obscure, and their classification into loose tribes rather than formal subgroups reflects this uncertainty. General characteristics include cloven hoofs and usually at least one of the sexes of a species having true horns.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000004"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/FOODON_03414374"
        },
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_9913"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000006",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000006",
      "skos:prefLabel": {
        "@value": "Caprine",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Goats and Sheep",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Any of various hollow-horned, bearded ruminant mammals of the genus Capra, originally of mountainous areas of the Old World, especially any of the domesticated forms of C. hircus, raised for wool, milk, and meat. (from American Heritage Dictionary on line) [Definition Source: NCI]",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000004"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_9963"
        },
        {
          "@id": "http://purl.obolibrary.org/obo/NCIT_C14210"
        }
      ]
    },
