    {
      "@id": "urn:era-aom:livestock:AOM_000939",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000939",
      "skos:prefLabel": {
        "@value": "stocking rate as livestock units",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "The livestock unit, abbreviated as LSU (or sometimes as LU), is a reference unit which facilitates the aggregation of livestock from various species and age as per convention, via the use of specific coefficients established initially on the basis of the nutritional or feed requirement of each type of animal. The reference unit used for the calculation of livestock units (=1 LSU) is the grazing equivalent of one adult dairy cow producing 3 000 kg of milk annually, without additional concentrated foodstuffs. Holdings with livestock can have zero livestock units as LSU is only calculated for bovine animals, goats, sheep, equidae, pigs, poultry, and female breeding rabbits. Holdings with livestock and no LSU are holdings which have beehives or other livestock not elsewhere classified.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000938"
      },
      "skos:relatedMatch": [
        {
          "@id": "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:Livestock_unit_(LSU)"
        }
      ]
    },
