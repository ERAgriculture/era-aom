        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Sharptooth Catfish",
          "@language": "en"
        },
        {
          "@value": "North African Catfish",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "A species of catfish of the family Clariidae, the airbreathing catfishes. The African sharptooth catfish was introduced all over the world in the early 1980s for aquaculture purposes, so is found in countries far outside its natural habitat, such as Brazil, Vietnam, Indonesia, and India.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000034"
      },
