        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000040",
      "skos:prefLabel": {
        "@value": "Common Carp",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Mirror Carp",
          "@language": "en"
        },
        {
          "@value": "Carp",
          "@language": "en"
        },
        {
          "@value": "Koi",
          "@language": "en"
        },
        {
          "@value": "Fancy Carp",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "The common carp or European carp (*Cyprinus carpio*) is a widespread freshwater fish of eutrophic waters in lakes and large rivers in Europe and Asia. It gives its name to the carp family *Cyprinidae. Cyprinus carpio* is the number 3 fish of aquaculture after Grass carp and Silver carp.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000034"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_7962"
        }
      ]
    },
    {
