      },
      "skos:notation": "AOM_000367",
      "skos:prefLabel": {
        "@value": "Total Weight Gain",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Total change in animal weight for the entire experimental period.",
        "@language": "en"
      },
