    {
      "@id": "urn:era-aom:livestock:AOM_000010",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000010",
      "skos:prefLabel": {
        "@value": "Dromedary",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Arabian Camel",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "The dromedary camel or Arabian camel (*Camelus dromedarius*) is a large, even-toed ungulate with one hump on its back. It was first described by Carl Linnaeus in 1758. The dromedary camel is the second largest member of the camel family after the larger Bactrian camel.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000011"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_9838"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000011",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000011",
      "skos:prefLabel": {
        "@value": "Camel",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Camelid",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Camelids are members of the biological family Camelidae, the only currently living family in the suborder Tylopoda. The extant members of this group are: dromedary camels, Bactrian camels, wild Bactrian camels, llamas, alpacas, vicuñas, and guanacos.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000004"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/FOODON_03412103"
        },
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_9835"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000012",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000012",
      "skos:prefLabel": {
        "@value": "Taurine x Zebu Hybrid Cattle",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Bos taurus X Bos indicus",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "A taxonomic concept used in AOM to identify Taurine x Zebu Hybrid Cattle within the Cattle classification.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000015"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_30522"
        },
        {
          "@id": "http://snomed.info/id/125094007"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000013",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000013",
      "skos:prefLabel": {
        "@value": "Zebu Cattle",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Bos taurus indicus",
          "@language": "en"
        },
        {
          "@value": "Indicine cattle",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Zebus (*Bos indicus* or *Bos taurus indicus*), sometimes known as 'nothing cattle', are better-adapted to tropical environments than other domestic cattle. Their scientific name was originally *Bos indicus*, but this name is now deemed invalid by ITIS, who classify the zebu under *Bos taurus* along with all other domestic cattle, and their aurochs ancestors, domesticated in India about 10,000 years ago. However, In 2011, Colin Groves and Peter Grubb classified it as a distinct species again and the American Society of Mammalogists also considers it to be a species. The ancient species of *Bos nomadicus* cattle or even gaur may have contributed to the development of the zebus. There are some 75 known breeds, split about evenly between African breeds and South Asian ones. The major Zebu cattle breeds of the world include Gyr, Guzerat, Indu-Brazilian, Nellore, Ongole and Brahman. Zebu have humps, large dewlaps and ears. They have more sweat glands than European cattle (*Bos taurus*). They handle hot, humid climates well and have pest resistances not seen in European cattle.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000015"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/FOODON_03413367"
        },
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_9915"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000014",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000014",
      "skos:prefLabel": {
        "@value": "Taurine Cattle",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Taurine cattle (Bos taurus taurus), also called European cattle, are a subspecies of domesticated cattle originating in the Near East. Both taurine cattle and indicine cattle (zebus) are descended from the aurochs. Taurine cattle were originally considered a distinct species, but are now typically grouped with zebus and aurochs into one species, Bos taurus. Most modern breeds of cattle are taurine cattle.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000015"
      },
      "skos:relatedMatch": [
        {
          "@id": "http://purl.obolibrary.org/obo/FOODON_00002507"
        },
        {
          "@id": "http://purl.obolibrary.org/obo/NCBITaxon_99133"
        }
      ]
    },
    {
      "@id": "urn:era-aom:livestock:AOM_000015",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000015",
      "skos:prefLabel": {
        "@value": "Cattle",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Bos primigenius taurus",
          "@language": "en"
        },
        {
          "@value": "Bos bovis",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Cattle (colloquially cows) are the most common type of large domesticated ungulates. They are a prominent modern member of the subfamily *Bovinae*.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000005"
      },
      "skos:relatedMatch": [
        {
