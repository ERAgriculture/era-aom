      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_000258",
      "skos:prefLabel": {
        "@value": "Neutral Detergent Solubles (NDS)",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "NDS refers to the soluble components of animal feeds that are extracted using a neutral detergent solution. These solubles include proteins, sugars, starches, and lipids, representing the more readily digestible and available nutrients in the feed.  (HV GPT4)",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000196"
      }
    },
