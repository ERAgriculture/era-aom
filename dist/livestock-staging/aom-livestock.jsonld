        "@value": "Neutral Detergent Fibre (NDF)",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Any measurable characteristic related to the concentration of cellulosic, hemicellulosic and lignin fractions of vegetal cell wall components in food. It could be declared by the manufacturer. Source: EOL",
        "@language": "en"
      },
      "skos:broader": {
