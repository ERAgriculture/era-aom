    {
      "@id": "urn:era-aom:livestock:AOM_001062",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_001062",
      "skos:prefLabel": {
        "@value": "Feed Digestibility",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Feed digestibility is a quantitative measure of the proportion of nutrients in a livestock feed that can be effectively broken down and absorbed by an animal's digestive system. It reflects the efficiency of nutrient utilization from the consumed feed, accounting for factors such as feed composition  and processing. (HV GPT4)",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000328"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_001063",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_001063",
      "skos:prefLabel": {
        "@value": "In vitro",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "In vitro refers to experiments performed outside the living organism, usually in a controlled laboratory environment. For feed digestibility, in vitro methods simulate the animal's digestive process using rumen fluid, fecal inoculum, or enzymes in a test tube or other container.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000300"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_001064",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_001064",
      "skos:prefLabel": {
        "@value": "In vivo",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "In vivo refers to experiments conducted within living organisms. In the context of feed digestibility, in vivo methods involve measuring nutrient utilization and digestion directly within the animal. (HV GPT4)",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000300"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_001065",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
