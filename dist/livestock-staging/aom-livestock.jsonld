      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Feeds added to animal diets that are non-plant, non-animal or non-manure based materials.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_003003"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003011",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003011",
      "skos:prefLabel": {
        "@value": "Feed Substitution",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "Components of a basal diet fully or partially substituted for residues from crops not primarily grown for fodder, but for another purpose (e.g. consumption). These can be field residues (for example maize stalks left over once the grain component has been harvested) and or processing residues (for example the maize bran produced as a byproduct of milling flour).",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000108"
      }
    },
    {
      "@id": "urn:era-aom:livestock:AOM_003012",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era-aom:scheme:livestock-v2"
      },
      "skos:notation": "AOM_003012",
      "skos:prefLabel": {
        "@value": "Basal or Conventional Diet",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:definition": {
        "@value": "A diet fed to animals without additional of anything.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_003011"
      }
    },
