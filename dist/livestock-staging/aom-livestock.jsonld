        {
          "@value": "Chloris abyssinica",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Rhodes grass (Chloris gayana Kunth) is an important tropical grass widespread in tropical and subtropical countries. It is a useful forage for pasture and hay, drought-resistant and very productive, of high quality when young. [Feedipedia]",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "urn:era-aom:livestock:AOM_000058"
      },
      "skos:relatedMatch": [
