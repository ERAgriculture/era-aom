      "skos:notation": "AOM_000028",
      "skos:prefLabel": {
        "@value": "Turkey",
        "@language": "en"
      },
      "era:conceptType": "legacy_aom_concept",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Wild Turkey",
          "@language": "en"
        },
        {
          "@value": "Common Turkey",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "A large fowl, one of the two species in the genus Meleagris and the same as the wild turkey. [...] all of the main domestic turkey varieties today descend from the turkey raised in central Mexico that was subsequently imported into Europe by the Spanish in the 16th century.",
        "@language": "en"
      },
      "skos:broader": {
