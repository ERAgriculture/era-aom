    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Any measurable or observable characteristics related to the concentration of hemicellulose (CHEBI:61266) in feed. Hemicellulose is a heterogeneous group of polysaccharides found in plant cell walls. In animal feeds, hemicellulose contributes to dietary fiber and is more easily broken down than cellulose, making it a source of fermentable carbohydrates for ruminants and other animals with specialized digestive systems. (HV GPT4)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
