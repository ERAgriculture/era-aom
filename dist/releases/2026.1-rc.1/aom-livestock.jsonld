  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000134",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000120"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An experimental diet contains more urea supplement than a control diet.  Urea is a high-nitrogen compound that can be converted by rumen microbes into usable protein for the animal. Urea treatment is a cost-effective way to increase the protein content of low-quality forage and other feed sources, particularly in areas where high-quality protein supplements are not readily available (human validated ChatGPT)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000134"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "urea supplementation"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
