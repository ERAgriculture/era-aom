  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_003202",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/era-aom/schema/ProcessingMethod"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_100991"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Molasses treatment involves applying molasses to fibrous feeds such as straw, stover, or hay to enhance palatability, increase energy content, and reduce dustiness. While it does not chemically alter fiber structure like alkali treatments, molasses provides readily fermentable carbohydrates that improve feed intake and support rumen microbial activity. It is often used as a carrier for urea or minerals in treated feeds and is widely adopted in both smallholder and commercial livestock systems for its ease of use and positive impact on voluntary intake."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_003202"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Molasses Treatment"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000521",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
