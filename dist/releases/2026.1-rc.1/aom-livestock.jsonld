    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "True Digestibility takes into account the endogenous losses of nutrients, which are the nutrients excreted by the animal from sources other than the diet, such as metabolic processes and secretions from the digestive system. By correcting for these endogenous losses, true digestibility provides a more accurate representation of the actual utilization of the feed's nutrients by the animal. (HV GPT4)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
