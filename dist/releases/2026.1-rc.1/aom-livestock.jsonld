    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Elephant Grass"
      },
      {
        "@language": "en",
        "@value": "Bana Grass"
      },
      {
        "@language": "en",
        "@value": "Uganda Grass"
      },
      {
