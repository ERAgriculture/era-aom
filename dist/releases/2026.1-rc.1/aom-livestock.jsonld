    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An experimental diet contains more protease enzyme (BAO_0000652) supplements than a control diet. Proteases are enzymes that break down proteins into smaller peptides and amino acids, which are more easily absorbed and utilized by the animal. Proteases are commonly used in to improve protein digestion and utilization (human validated ChatGPT)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
