      },
      {
        "@language": "en",
        "@value": "Napier"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000058"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Elephant grass (Pennisetum purpureum Schumach.) is a major tropical grass. It is one of the highest yielding tropical grasses. It is a very versatile species that can be grown under a wide range of conditions and systems: dry or wet conditions, smallholder or larger scale agriculture. It is a valuable forage and very popular throughout the tropics, notably in cut-and-carry systems (Mannetje, 1992; FAO, 2015). [Feedipedia]"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000063"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Napier Grass"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "https://www.feedipedia.org/node/12365"
      },
      {
        "@id": "http://purl.obolibrary.org/obo/NCBITaxon_59786"
      }
    ],
