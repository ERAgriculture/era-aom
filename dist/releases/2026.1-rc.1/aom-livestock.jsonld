    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_001062"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A digestibility measurement method is a systematic, scientifically-based approach used to assess the proportion of nutrients in a livestock feed that can be effectively broken down and absorbed by an animal's digestive system. These methods typically involve the collection and analysis of feed and fecal samples, and may include in vivo techniques, such as direct or indirect digestibility assays, or in vitro techniques, such as enzyme or microbial-based assays. The objective is to evaluate the efficiency of nutrient utilization from the feed, informing decisions on optimizing animal nutrition strategies. (HV GPT4)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
