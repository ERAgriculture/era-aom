  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000368",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000366"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Specific Growth Rate (SGR) is typically measured as the change in body weight of an animal over a specified time period, divided by the number of days in that period. For example, if an animal weighed 100 kg at the beginning of a 30-day period and weighed 120 kg at the end of that period, the SGR would be calculated as follows: SGR = (120 kg - 100 kg) ÷ 30 days = 0.67 kg/day.  This indicates that the animal gained an average of 0.67 kg per day during the 30-day period.  (human validated chatGPT)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000368"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Specific Growth Rate"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
