  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000031",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000024"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A species of Old World quail found in East Asia. First considered a subspecies of the common quail, it was distinguished as its own species in 1983. As the Japanese quail is easily managed, fast growing, small in size, and can produce eggs at a high rate, it has been farmed in large quantities across the globe."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000031"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Japanese Quail"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://purl.obolibrary.org/obo/NCBITaxon_93934"
      },
      {
        "@id": "http://purl.obolibrary.org/obo/FOODON_03411346"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
