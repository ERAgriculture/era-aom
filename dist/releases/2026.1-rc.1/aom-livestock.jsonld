  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000069",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Cockspur"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000058"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Cocksfoot (Dactylis glomerata L.) is a strongly tufted, deep-rooted, long-lived perennial reaching a height of 60-150 cm. Culms are erect and glabrous. Leaf blades are 30-60 cm long and 5-10 mm broad. Inflorescences are erect panicles, 8-20 cm long, bearing spikelets in dense one-sided clusters. Cocksfoot produces a continuous growth of young leaves and can withstand heavy grazing (Göhl, 1982). It is used for pasture, hay and silage (Ecoport, 2010; Ecocrop, 2010). The main advantage of cocksfoot is greater forage production during summer compared to other forage grasses: it stays green after most prairy grasses have dried (USDA, 2010). Because of its shade tolerance cocksfoot is also used in Europe to establish vegetation cover in vineyards or orchards (Sanada et al., 2010). Numerous cultivars of cocksfoot have been developed for late maturing, higher leafiness, higher productivity, better disease resistance, wider adaptability and nutritive value (Hannaway et al., 1999). [Feedipedia]"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000069"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Cocksfoot"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://purl.obolibrary.org/obo/NCIT_C72299"
      },
      {
        "@id": "https://www.feedipedia.org/node/11991"
      },
      {
        "@id": "http://purl.obolibrary.org/obo/NCBITaxon_4509"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
