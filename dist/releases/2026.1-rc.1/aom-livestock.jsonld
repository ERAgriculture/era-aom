        "@language": "en",
        "@value": "Perennial Ryegrass"
      },
      {
        "@language": "en",
        "@value": "Lolium"
      },
      {
        "@language": "en",
        "@value": "Italian Ryegrass"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000058"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The most important cultivated temperate grasses. Also grown in subtropical areas of Australia, S America and S Africa; in the tropics, ryegrass is grown to a limited extent at high altitudes, e.g. in Colombia or Kenya, ryegrass is grown above 2400-2500 m alt. Often sown in mixtures with white clover. L. multiflorum is less persistent, dying out after 2-3 years of productive growth. It withstands drier and hotter conditions better than L. perenne and in the tropics it can be grown at somewhat lower altitudes than the latter. [Feedipedia]"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
