  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000288",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_001064"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The Difference Technique is a method for estimating livestock feed digestibility without the need to collect and weigh total feces. This approach uses an indigestible reference substance, either naturally present in the feed (internal indicator) or added to it (external indicator). Commonly used indicators include ferric oxide, chromic oxide, lignin, silica, chromogen, acid-insoluble ash, or indigestible acid detergent fiber. Digestibility is determined by comparing the relationship between nutrients and the indicator substance in both feed and feces.\n\nThe digestion coefficient of a nutrient can be calculated using the following formula:\n\nDigestion coefficient of a nutrient = 100 - (100 * ((% Indicator in feed * % Nutrient in feces) / (% Indicator in feces * % Nutrient in feed)))\n\nThis method enables the evaluation of nutrient digestibility by analyzing the chemical composition of feed and fecal samples, without the need to measure feed intake or feces output."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000288"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Difference Technique"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
