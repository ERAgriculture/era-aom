  {
    "@id": "https://w3id.org/era-aom/livestock/AOM_000298",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_001064"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The Total Collection Method is an accurate approach for measuring feed digestibility, where feed intake and fecal output are recorded over a specified period. Despite being labor-intensive and time-consuming, it is considered highly reliable.\n\nTo calculate nutrient digestibility in a test diet, it is assumed that the digestibility of a mixed diet equals the sum of the proportions supplied by each ingredient when fed individually. The digestibility of a nutrient in the experimental feed, when part of a mixed diet, is calculated using the following formula:\n\nDigestibility of nutrient in test feed (%) = (A - (100 * B * C)) / D\n\nWhere:\nA = Nutrient digestibility in the total diet\nB = Nutrient digestibility in the basal diet (previously determined when fed alone)\nC = Proportion of the total nutrient in the diet supplied by the basal diet\nD = Proportion of the total nutrient in the diet supplied by the test feed"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000297"
      },
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000296"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000298"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Total Collection Technique"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
