    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Livestock reproductive yield is a metric used to evaluate the efficiency of reproduction in livestock. It measures the percentage of successful pregnancies or offspring produced per female animal. A higher reproductive yield indicates better reproductive performance and more efficient breeding practices (human validated chatGPT)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
