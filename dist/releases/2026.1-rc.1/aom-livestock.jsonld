        "@id": "https://w3id.org/era-aom/livestock/AOM_000125"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An experimental diet contains more lipase enzyme (TXPO_0002283) supplements than a control diet. Lipases are enzymes that break down fats and oils into fatty acids and glycerol, which can be used for energy by the animal (human validated ChatGPT). Lipases are commonly used in poultry and swine diets to improve fat digestion and utilization (human validated ChatGPT)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000129"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "lipase supplementation"
      }
    ],
    "urn:era:property:conceptType": [
      {
        "@value": "legacy_aom_concept"
      }
    ],
    "urn:era:property:status": [
      {
        "@value": "unknown"
      }
    ]
  },
