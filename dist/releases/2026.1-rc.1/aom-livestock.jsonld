        "@id": "https://w3id.org/era-aom/livestock/AOM_000331"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An ectoparasiticide is a chemical agent or substance used to control, repel, or kill ectoparasites, which are external parasites that infest the skin or outer surfaces of their host animals. Examples of ectoparasites include ticks, mites, fleas, and lice. Ectoparasiticides are commonly used in livestock production to maintain animal health, prevent the spread of diseases, and improve overall productivity. (HV GPT4)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/era-aom/scheme/livestock-v2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000344"
      },
      {
        "@id": "https://w3id.org/era-aom/livestock/AOM_000345"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AOM_000343"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Ectoparasiticide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://purl.obolibrary.org/obo/CHEBI_38956"
      }
    ],
