    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000037> a skos:Concept ;
    skos:altLabel "Mollusk"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000035> ;
    skos:definition "Mollusca is a large phylum of invertebrate animals whose members are known as molluscs or mollusks. Molluscs are the largest marine phylum, comprising about 23% of all the named marine organisms. Numerous molluscs also live in freshwater and terrestrial habitats. [https://en.wikipedia.org/wiki/Mollusca]"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
