<https://w3id.org/era-aom/livestock/AOM_000074> a skos:Concept ;
    skos:altLabel "Cardyne Vetch"@en,
        "Corbière Hairy Vetch"@en,
        "Fodder Vetch"@en,
        "Lana Vetch"@en,
        "Sand Vetch"@en,
        "Smooth Vetch"@en,
        "Thick-fruited Vetch"@en,
        "Winter Vetch"@en,
        "Woolly Vetch"@en,
        "Woolly-pod Vetch"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000059> ;
    skos:definition "Hairy vetch (Vicia villosa Roth) is an annual or biannual viny legume with a woolly appearance due to long soft hairs borne on the stems and leaves (FAO, 2014; Cook et al., 2005; Undersander et al., 1990). It remains green longer than the common vetch (Vicia sativa). It flowers and Seed late in the season and often survives the dry season, regenerating to almost full strength during the next rainy season (Göhl, 1982). [Feedipedia]"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000074" ;
    skos:prefLabel "Hairy Vetch"@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/NCBITaxon_3911>,
        <https://www.feedipedia.org/node/12787> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000075> a skos:Concept ;
    skos:altLabel "Italian Ryegrass"@en,
        "Lolium"@en,
        "Perennial Ryegrass"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000058> ;
    skos:definition "The most important cultivated temperate grasses. Also grown in subtropical areas of Australia, S America and S Africa; in the tropics, ryegrass is grown to a limited extent at high altitudes, e.g. in Colombia or Kenya, ryegrass is grown above 2400-2500 m alt. Often sown in mixtures with white clover. L. multiflorum is less persistent, dying out after 2-3 years of productive growth. It withstands drier and hotter conditions better than L. perenne and in the tropics it can be grown at somewhat lower altitudes than the latter. [Feedipedia]"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000075" ;
    skos:prefLabel "Ryegrass"@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/FOODON_03413386>,
        <http://purl.obolibrary.org/obo/NCBITaxon_4520>,
        <https://www.feedipedia.org/node/625> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000076> a skos:Concept ;
    skos:altLabel "European blue lupine"@en,
        "New Zealand blue lupin"@en,
        "blue lupine"@en,
        "narrow leaf lupin"@en,
        "narrow leafed lupin"@en,
        "narrow leaved lupin"@en,
        "narrow-leaf lupin"@en,
        "narrow-leafed lupin"@en,
        "narrow-leaved blue lupin"@en,
        "narrow-leaved lupin"@en,
        "narrowleaf lupin"@en,
        "narrowleaf lupine"@en,
        "sweet lupinseed"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000059> ;
    skos:definition "Blue lupin (Lupinus angustifolius L.) is a legume crop used for seed and fodder. This species is the main lupin species used for forage. It is grazed green or as stubble or cut and made into hay or silage. Like other lupin species, blue lupin Seed are a potential alternative to soybeans. [Feedipedia]"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000076" ;
    skos:prefLabel "Blue Lupin"@en ;
