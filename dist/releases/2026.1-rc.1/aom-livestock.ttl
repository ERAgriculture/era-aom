<https://w3id.org/era-aom/livestock/AOM_000819> a skos:Concept,
        aom:ProcessingMethod ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_100991> ;
    skos:definition "Alkali treatment is an feed processing technique that involves the application of alkaline substances to raw feed materials, primarily to enhance the digestibility of fibrous components. This process typically uses alkaline agents, such as sodium hydroxide, potassium hydroxide, or ammonia, which can solubilize hemicellulose, lignin, and other complex carbohydrates, improving the overall nutritional value of fibrous feedstuffs. (HV GPT4)"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:narrower <https://w3id.org/era-aom/livestock/AOM_000817>,
        <https://w3id.org/era-aom/livestock/AOM_100848> ;
    skos:notation "AOM_000819" ;
    skos:prefLabel "Alkali Treatment"@en ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000827> a skos:Concept,
        aom:ProcessingMethod ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000826> ;
    skos:definition "Feed boiling refers to the process of heating animal feed in water or steam for a specific period of time to improve its digestibility and nutritional value by reducing anti-nutritional factors, such as toxins and enzyme inhibitors, and by increasing the availability of nutrients to the animal. (Human validated chatGPT)."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:narrower <https://w3id.org/era-aom/livestock/AOM_000828>,
        <https://w3id.org/era-aom/livestock/AOM_000829> ;
    skos:notation "AOM_000827" ;
    skos:prefLabel "Boiling"@en ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

