<https://w3id.org/era-aom/livestock/AOM_000022> a skos:Concept ;
    skos:altLabel "Equus asinus x Equus caballus"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000008> ;
    skos:definition "A mule is the offspring of a male donkey and a female horse. Horses and donkeys are different species, with different numbers of chromosomes. Of the two F1 hybrids between these two species, a mule is easier to obtain than a hinny (the offspring of a male horse and a female donkey). All male mules and most female mules are infertile"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000022" ;
    skos:prefLabel "Mule"@en ;
    skos:relatedMatch <http://aims.fao.org/aos/agrovoc/c_4979>,
        <http://purl.obolibrary.org/obo/FOODON_03412093> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

