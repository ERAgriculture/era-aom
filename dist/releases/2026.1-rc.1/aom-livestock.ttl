<https://w3id.org/era-aom/livestock/AOM_000011> a skos:Concept ;
    skos:altLabel "Camelid"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000004> ;
    skos:definition "Camelids are members of the biological family Camelidae, the only currently living family in the suborder Tylopoda. The extant members of this group are: dromedary camels, Bactrian camels, wild Bactrian camels, llamas, alpacas, vicuñas, and guanacos."@en ;
