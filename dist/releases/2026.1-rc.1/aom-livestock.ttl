<https://w3id.org/era-aom/livestock/AOM_000121> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000120> ;
    skos:definition "An experimental diet contains more vitamin (NCIT_C944) supplements than a control diet."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000121" ;
