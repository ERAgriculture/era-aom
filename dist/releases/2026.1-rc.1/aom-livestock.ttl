    skos:definition "any measurable characteristic related to the concentration of copper (CHEBI:28694) in food"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000236" ;
    skos:prefLabel "Copper"@en ;
    skos:relatedMatch <http://opendata.inra.fr/EOL/EOL_0000158> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000237> a skos:Concept ;
    skos:altLabel "Crude Lipid"@en,
        "Total Extractable Fat"@en,
        "Total Extractable Lipids"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000196> ;
    skos:definition """Crude fat is a measure of the total extractable lipids (CHEBI:18059) present in feed materials, including triglycerides, phospholipids, sterols, and other fatty substances. It is an essential component of livestock diets, as it serves as a concentrated source of energy and provides essential fatty acids for growth, reproduction, and overall health. The crude fat content is determined by solvent extraction methods, which help estimate the energy value of feedstuffs and guide the formulation of nutritionally balanced animal diets.

Crude fat and crude lipid are often used interchangeably to refer to the same measure of extractable lipids in feed materials. However, the term "lipid" is broader in scope, encompassing a wider variety of fat-soluble compounds, whereas "fat" typically refers to triglycerides and closely related substances. Despite this distinction, both terms are commonly used to describe the total lipid content of animal feeds. (HV GPT4)"""@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000237" ;
    skos:prefLabel "Crude Fat"@en ;
    skos:relatedMatch <http://aims.fao.org/aos/agrovoc/c_32416> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000238> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000196> ;
    skos:definition "A measurement of fibre content. Also known as Weende cellulose, crude fibre is the insoluble residue of an acid hydrolysis followed by an alkaline one. This residue contains true cellulose and insoluble lignin. It is also used to assess hair, hoof or feather residues in animal by-products. Even though the more accurate Van Soest analysis has superseded it since the 1970s, the analysis of crude fibre remains common in feed laboratories. Source: Feedipedia"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000238" ;
    skos:prefLabel "Crude Fibre"@en ;
    skos:relatedMatch <http://aims.fao.org/aos/agrovoc/c_330618>,
        <http://opendata.inra.fr/EOL/EOL_0000117>,
        <https://www.feedipedia.org/node/8330> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000239> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000196> ;
    skos:definition "A measurement of protein content. In animal feeds, crude protein is calculated as mineral nitrogen x 6.25 (the assumption is that proteins of typical animal feeds contain 16% nitrogen in average). The mineral nitrogen value is obtained by the Kjeldahl method, or by a method giving similar results after correction, such as the Dumas method. Source: Feedipedia"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000239" ;
    skos:prefLabel "Crude Protein"@en ;
    skos:relatedMatch <http://aims.fao.org/aos/agrovoc/c_330614>,
        <http://www.cropontology.org/rdf/CO_345:0000016>,
        <https://www.feedipedia.org/node/8329> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_000240> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000196> ;
    skos:definition "Dry matter is calculated as the difference between the total weight and the moisture content. It is usually obtained by oven-drying, but there are methods specific to products such as silages, fats and molasses. Usually abbreviated as DM. Source: Feedipedia"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000240" ;
    skos:prefLabel "Dry Matter"@en ;
    skos:relatedMatch <http://aims.fao.org/aos/agrovoc/c_2398>,
        <http://opendata.inra.fr/EOL/EOL_0000067>,
        <https://www.feedipedia.org/node/8331> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

