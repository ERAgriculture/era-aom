<https://w3id.org/era-aom/livestock/AOM_003002> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000025> ;
    skos:definition "Broiler chickens are raised commercially for their meat and will grow to be 3-6 pounds by 8 weeks of age but tend to be afflicted by health problems related to this fast growth, including skeletal weakness, congestive heart failure, and a decrease in fertility. Derived from a cross between a white cornish male and a barred rock female in the 1930s, modern broilers are an F2 hybrid of broiler breeds characterized by high fecundity and fast growth."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_003002" ;
    skos:prefLabel "Broiler"@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/FOODON_03411198> ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_003004> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_003014> ;
    skos:definition "Feeds added to animal diets that come from non-woody crops usually grown for human consumption. These can be crop grain, field residues (for example maize stalks left over once the grain component has been harvested), or processing residues (for example the maize bran produced as a byproduct of milling flour). Soyabeans fit in this category as they are grown for human consumption and livestock feed."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_003004" ;
    skos:prefLabel "Product"@en ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_003005> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_003003> ;
    skos:definition "Feeds added to animal diets that are derived from non-woody crops grown primarily to feed to animals (e.g., alfafa or clover grown to feed to cattle) or non-woody plants harvested from non-cropped areas (e.g., forage grasses such as napier grass grown to stabilize terraces, cactus harvested from boundary fences, wild growing plants in wayside or fallows, algae, etc.)."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_003005" ;
    skos:prefLabel "Non Crop Fodders"@en ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_003006> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_003003> ;
    skos:definition "Feeds added to animal diets that are from agroforestry shrub or tree fodders or other woody plants."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_003006" ;
    skos:prefLabel "Agroforestry Fodders"@en ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

<https://w3id.org/era-aom/livestock/AOM_003007> a skos:Concept ;
