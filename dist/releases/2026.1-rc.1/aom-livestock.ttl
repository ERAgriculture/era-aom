<https://w3id.org/era-aom/livestock/AOM_000343> a skos:Concept ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000331> ;
    skos:definition "An ectoparasiticide is a chemical agent or substance used to control, repel, or kill ectoparasites, which are external parasites that infest the skin or outer surfaces of their host animals. Examples of ectoparasites include ticks, mites, fleas, and lice. Ectoparasiticides are commonly used in livestock production to maintain animal health, prevent the spread of diseases, and improve overall productivity. (HV GPT4)"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:narrower <https://w3id.org/era-aom/livestock/AOM_000344>,
        <https://w3id.org/era-aom/livestock/AOM_000345> ;
    skos:notation "AOM_000343" ;
    skos:prefLabel "Ectoparasiticide"@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/CHEBI_38956> ;
