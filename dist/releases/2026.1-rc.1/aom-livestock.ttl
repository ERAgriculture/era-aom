<https://w3id.org/era-aom/livestock/AOM_000844> a skos:Concept,
        aom:ProcessingMethod ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000842> ;
    skos:definition "Wilting is a feed processing technique that involves partial dehydration of raw feed materials, typically through natural methods like sun or air exposure. The process reduces moisture content, which can improve preservation, handling, and storage properties, particularly for forage or silage production. (HV GPT4)"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_000844" ;
    skos:prefLabel "Wilting"@en ;
