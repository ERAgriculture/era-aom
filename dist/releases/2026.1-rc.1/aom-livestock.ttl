<https://w3id.org/era-aom/livestock/AOM_000104> a skos:Concept ;
    skos:altLabel "Andropogon bisquamulatus"@en,
        "Andropogon squamulatus"@en,
        "Bluestem"@en,
        "Gamba Grass"@en,
        "Onaga Grass"@en,
        "Rhodesian Andropogon"@en,
        "Rhodesian Blue Grass"@en,
        "Tambuki Grass"@en ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000058> ;
    skos:definition "Gamba grass (Andropogon gayanus Kunth) is a perennial leafy grass of tropical Africa. Highly productive, drought- and fire-resistant grass, it forms dense stands used for pastures, hay and cut-and-carry systems. It is relished by livestock when young (before heading) and loses its nutritional value when it matures. [Feedipedia]"@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:narrower <https://w3id.org/era-aom/livestock/AOM_001875> ;
