<https://w3id.org/era-aom/livestock/AOM_100848> a skos:Concept,
        aom:ProcessingMethod ;
    skos:broader <https://w3id.org/era-aom/livestock/AOM_000819> ;
    skos:definition "Urea treatment is a form of alkali processing in which urea is applied to low-quality fibrous feeds—such as straw or crop residues—to improve digestibility. Through enzymatic hydrolysis by urease, urea is converted into ammonia, which breaks lignocellulosic bonds and increases the nitrogen content of the feed. This method is commonly used in smallholder and mixed crop-livestock systems due to its low cost, ease of application, and dual benefit of improving both physical structure and crude protein value of the treated material."@en ;
    skos:inScheme <https://w3id.org/era-aom/scheme/livestock-v2> ;
    skos:notation "AOM_100848" ;
    skos:prefLabel "Urea Treatment"@en ;
    era:conceptType "legacy_aom_concept" ;
    era:status "unknown" .

