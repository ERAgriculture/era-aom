  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000134">
    <skos:prefLabel xml:lang="en">urea supplementation</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">An experimental diet contains more urea supplement than a control diet.  Urea is a high-nitrogen compound that can be converted by rumen microbes into usable protein for the animal. Urea treatment is a cost-effective way to increase the protein content of low-quality forage and other feed sources, particularly in areas where high-quality protein supplements are not readily available (human validated ChatGPT).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000120"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:notation>AOM_000134</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000355">
