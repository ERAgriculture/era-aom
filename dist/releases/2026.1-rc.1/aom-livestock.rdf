  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000010">
    <skos:altLabel xml:lang="en">Arabian Camel</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000011"/>
    <era:status>unknown</era:status>
    <skos:prefLabel xml:lang="en">Dromedary</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:notation>AOM_000010</skos:notation>
    <skos:definition xml:lang="en">The dromedary camel or Arabian camel (*Camelus dromedarius*) is a large, even-toed ungulate with one hump on its back. It was first described by Carl Linnaeus in 1758. The dromedary camel is the second largest member of the camel family after the larger Bactrian camel.</skos:definition>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9838"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
