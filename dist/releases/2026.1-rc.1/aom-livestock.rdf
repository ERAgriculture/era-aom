    <skos:definition xml:lang="en">Extrusion is a feed processing technique that involves forcing raw feed materials through a shaped die under high pressure and temperature conditions, resulting in a continuous, uniformly shaped product. This process can alter the physical and chemical properties of feed materials, improving digestibility, nutrient availability, and palatability. Extrusion is both a thermal and mechanical process. (HV GPT4)</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Extrusion</skos:prefLabel>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000833</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000826"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000838">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">Milling typically refers to the process of using rotary cutters or millstones to grind, crush, or shear feed materials into smaller particles. Milling can produce a wide range of particle sizes and is often used for producing flour or meal from grains and other feedstuffs.  (HV GPT4)</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000837"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Milling</skos:prefLabel>
    <skos:notation>AOM_000838</skos:notation>
  </rdf:Description>
