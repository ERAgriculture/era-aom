    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">Amylase treatment: Amylase treatment is a feed processing approach that involves adding amylase enzymes to raw feed materials before animal consumption. Amylases break down complex carbohydrates, such as starch, into simpler sugars, which enhances energy availability and overall feed efficiency. (HV GPT4)</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
