    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A species of catfish of the family Clariidae, the airbreathing catfishes. The African sharptooth catfish was introduced all over the world in the early 1980s for aquaculture purposes, so is found in countries far outside its natural habitat, such as Brazil, Vietnam, Indonesia, and India.</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:altLabel xml:lang="en">Sharptooth Catfish</skos:altLabel>
    <skos:altLabel xml:lang="en">North African Catfish</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000034"/>
    <skos:prefLabel xml:lang="en">African Sharptooth Catfish</skos:prefLabel>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_13013"/>
    <era:status>unknown</era:status>
