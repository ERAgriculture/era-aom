  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000095">
    <skos:altLabel xml:lang="en">Indian Hemp</skos:altLabel>
    <skos:altLabel xml:lang="en">Crotalaria benghalensis</skos:altLabel>
    <skos:altLabel xml:lang="en">Crotalaria porrecta</skos:altLabel>
    <skos:altLabel xml:lang="en">Crotalaria viminea</skos:altLabel>
    <skos:altLabel xml:lang="en">Crotalaria sericea</skos:altLabel>
    <skos:altLabel xml:lang="en">Benares Hemp</skos:altLabel>
    <skos:altLabel xml:lang="en">Crotalaria tenuifolia</skos:altLabel>
    <skos:altLabel xml:lang="en">Madras Hemp</skos:altLabel>
    <skos:altLabel xml:lang="en">Crotalaria fenestrata</skos:altLabel>
    <skos:altLabel xml:lang="en">Sunn Crotalaria</skos:altLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:prefLabel xml:lang="en">Sunn Hemp</skos:prefLabel>
    <era:status>unknown</era:status>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3829"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12669"/>
    <skos:definition xml:lang="en">Sunn hemp (Crotalaria juncea L.) is a multipurpose tropical and subtropical legume grown in many countries, notably India, mainly for its high quality fibre. The crop is grown for green manure, as a soil improver and as a disease break in cereal or other crop rotations (Tripathi et al., 2013). Sunn hemp is locally used as fodder (Sarkar et al., 2015). [Feedipedia]</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:notation>AOM_000095</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000059"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
