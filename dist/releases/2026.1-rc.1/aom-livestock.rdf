  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000260">
    <skos:prefLabel xml:lang="en">Nitrogen Free Extracts (NFE)</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <skos:definition xml:lang="en">Nitrogen Free Extracts (NFE) is an estimate of the readily available carbohydrate content of animal feeds, calculated by subtracting the percentages of crude protein, crude fat, crude fiber, and ash from 100. NFE primarily includes sugars and starches, which provide energy for animal metabolism. (HV GPT4)</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000260</skos:notation>
    <era:status>unknown</era:status>
  </rdf:Description>
