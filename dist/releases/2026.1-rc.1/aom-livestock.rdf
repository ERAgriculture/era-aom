    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3871"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/25373"/>
    <skos:definition xml:lang="en">Blue lupin (Lupinus angustifolius L.) is a legume crop used for seed and fodder. This species is the main lupin species used for forage. It is grazed green or as stubble or cut and made into hay or silage. Like other lupin species, blue lupin Seed are a potential alternative to soybeans. [Feedipedia]</skos:definition>
    <skos:prefLabel xml:lang="en">Blue Lupin</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:notation>AOM_000076</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000059"/>
  </rdf:Description>
