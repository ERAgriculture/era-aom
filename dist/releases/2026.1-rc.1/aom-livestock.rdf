    <skos:prefLabel xml:lang="en">Boiling</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">Feed boiling refers to the process of heating animal feed in water or steam for a specific period of time to improve its digestibility and nutritional value by reducing anti-nutritional factors, such as toxins and enzyme inhibitors, and by increasing the availability of nutrients to the animal. (Human validated chatGPT).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000826"/>
