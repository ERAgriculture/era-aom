  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000133">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000133</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000120"/>
    <skos:prefLabel xml:lang="en">organic acid supplementation</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An experimental diet contains more organic acid supplements than a control diet. Organic acids work in livestock feeds by reducing the pH of the gut, which creates an environment that is less hospitable to harmful bacteria (human validated ChatGPT). In addition to reducing pH, organic acids can also disrupt the cell membranes of bacteria, causing them to leak and die (human validated ChatGPT).</skos:definition>
  </rdf:Description>
