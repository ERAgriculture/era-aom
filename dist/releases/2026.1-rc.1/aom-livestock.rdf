    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">Grinding, usually involves the use of abrasive surfaces, such as grinding wheels or hammer mills, to reduce the size of feed particles through friction and impact. Grinding generally results in a more consistent and fine particle size compared to milling. (HV GPT4)</skos:definition>
    <skos:prefLabel xml:lang="en">Grinding</skos:prefLabel>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000839"/>
  </rdf:Description>
