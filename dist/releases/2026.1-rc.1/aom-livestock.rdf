    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:notation>AOM_000387</skos:notation>
    <skos:definition xml:lang="en">Reproductive rate in livestock refers to the rate at which female animals are able to conceive and produce offspring within a given time period. It is calculated as the number of successful pregnancies or offspring produced per female animal.</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
