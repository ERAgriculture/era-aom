  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000237">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <skos:notation>AOM_000237</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Crude Fat</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">Crude fat is a measure of the total extractable lipids (CHEBI:18059) present in feed materials, including triglycerides, phospholipids, sterols, and other fatty substances. It is an essential component of livestock diets, as it serves as a concentrated source of energy and provides essential fatty acids for growth, reproduction, and overall health. The crude fat content is determined by solvent extraction methods, which help estimate the energy value of feedstuffs and guide the formulation of nutritionally balanced animal diets.

Crude fat and crude lipid are often used interchangeably to refer to the same measure of extractable lipids in feed materials. However, the term "lipid" is broader in scope, encompassing a wider variety of fat-soluble compounds, whereas "fat" typically refers to triglycerides and closely related substances. Despite this distinction, both terms are commonly used to describe the total lipid content of animal feeds. (HV GPT4)</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <skos:altLabel xml:lang="en">Total Extractable Lipids</skos:altLabel>
    <skos:altLabel xml:lang="en">Crude Lipid</skos:altLabel>
    <skos:altLabel xml:lang="en">Total Extractable Fat</skos:altLabel>
    <skos:relatedMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_32416"/>
  </rdf:Description>
