    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:altLabel xml:lang="en">Trifolium brachycalycinum</skos:altLabel>
    <skos:altLabel xml:lang="en">Subterraneum Trefoil</skos:altLabel>
    <skos:altLabel xml:lang="en">Subclover</skos:altLabel>
    <skos:notation>AOM_000088</skos:notation>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">Subclover (Trifolium subterraneum L.) is a much valued annual legume forage used in ruminant production systems, particularly in drylands. It is particularly suited to grazing and can be cut for silage and hay. [Feedipedia]</skos:definition>
  </rdf:Description>
