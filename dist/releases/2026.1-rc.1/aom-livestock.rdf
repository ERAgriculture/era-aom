  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_003097">
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_003097</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000837"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Decortication is a mechanical process in which the outer hull, husk, or shell of seeds or grains is removed to reduce fiber content and improve the digestibility and nutritional quality of livestock feed. It is commonly applied to oilseeds such as cottonseed, groundnut, and sunflower before or after oil extraction.</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Decorticated</skos:prefLabel>
  </rdf:Description>
