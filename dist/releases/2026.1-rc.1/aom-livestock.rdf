  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000977">
    <skos:notation>AOM_000977</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000976"/>
    <era:status>unknown</era:status>
    <skos:prefLabel xml:lang="en">Calf Male</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">A controlled rearing-stage category scoped to Cattle;Buffalo; used for records classified as “Calf Male”.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000978"/>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000979"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_100848">
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000819"/>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">Urea treatment is a form of alkali processing in which urea is applied to low-quality fibrous feeds—such as straw or crop residues—to improve digestibility. Through enzymatic hydrolysis by urease, urea is converted into ammonia, which breaks lignocellulosic bonds and increases the nitrogen content of the feed. This method is commonly used in smallholder and mixed crop-livestock systems due to its low cost, ease of application, and dual benefit of improving both physical structure and crude protein value of the treated material.</skos:definition>
    <skos:prefLabel xml:lang="en">Urea Treatment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <skos:notation>AOM_100848</skos:notation>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_001799">
