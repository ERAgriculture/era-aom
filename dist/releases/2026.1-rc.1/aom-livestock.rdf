  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000844">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">Wilting is a feed processing technique that involves partial dehydration of raw feed materials, typically through natural methods like sun or air exposure. The process reduces moisture content, which can improve preservation, handling, and storage properties, particularly for forage or silage production. (HV GPT4)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000842"/>
    <skos:prefLabel xml:lang="en">Wilting</skos:prefLabel>
    <skos:notation>AOM_000844</skos:notation>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
  </rdf:Description>
