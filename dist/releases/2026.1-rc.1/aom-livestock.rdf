  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_001875">
    <skos:altLabel xml:lang="en">Tambuki Grass Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Rhodesian Andropogon Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Rhodesian Andropogon Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Onaga Grass Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Rhodesian Blue Grass Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Andropogon bisquamulatus Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Onaga Grass Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Gamba Grass Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Bluestem Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Gamba Grass Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Andropogon squamulatus Dried</skos:altLabel>
    <skos:altLabel xml:lang="en">Tambuki Grass Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Bluestem Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Andropogon squamulatus Hay</skos:altLabel>
    <skos:altLabel xml:lang="en">Rhodesian Blue Grass Dried</skos:altLabel>
    <skos:definition xml:lang="en">Gamba grass (Andropogon gayanus Kunth) is a perennial leafy grass of tropical Africa. Highly productive, drought- and fire-resistant grass, it forms dense stands used for pastures, hay and cut-and-carry systems. It is relished by livestock when young (before heading) and loses its nutritional value when it matures. [Feedipedia]</skos:definition>
    <skos:notation>AOM_001875</skos:notation>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000104"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12116"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_1092577"/>
    <skos:prefLabel xml:lang="en">Andropogon gayanus Dried</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
