    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">A vaccine is a processed material with the function that when administered, it prevents or ameliorates a disorder in a target organism by inducing or modifying adaptive immune responses specific to the antigens in the vaccine.</skos:definition>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/VO_0000001"/>
    <skos:prefLabel xml:lang="en">Vaccine</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:notation>AOM_000355</skos:notation>
  </rdf:Description>
