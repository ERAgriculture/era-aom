  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000130">
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000120"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401308"/>
    <skos:prefLabel xml:lang="en">probiotic supplementation</skos:prefLabel>
    <skos:notation>AOM_000130</skos:notation>
    <skos:definition xml:lang="en">An experimental diet contains more probiotic supplements than a control diet. Probiotics are live microorganisms thought to be healthy for the host organism. According to the currently adopted definition by FAO/WHO, probiotics are selected "live microorganisms which when administered in adequate amounts confer a health benefit on the host".[FAO/WHO (2001) Health and Nutritional Properties of Probiotics in Food including Powder Milk with Live Lactic Acid Bacteria. Report of a Joint FAO/WHO Expert Consultation on Evaluation of Health and Nutritional Properties of Probiotics in Food Including Powder Milk with Live Lactic Acid Bacteria] Lactic acid bacteria (LAB) and bifidobacteria are the most common types of microbes used as probiotics; but also certain yeasts and bacilli are available. [http://en.wikipedia.org/wiki/Probiotics]</skos:definition>
    <skos:altLabel xml:lang="en">probiotic or bacteria supplement</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
