  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_003002">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:prefLabel xml:lang="en">Broiler</skos:prefLabel>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411198"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000025"/>
    <skos:notation>AOM_003002</skos:notation>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">Broiler chickens are raised commercially for their meat and will grow to be 3-6 pounds by 8 weeks of age but tend to be afflicted by health problems related to this fast growth, including skeletal weakness, congestive heart failure, and a decrease in fertility. Derived from a cross between a white cornish male and a barred rock female in the 1930s, modern broilers are an F2 hybrid of broiler breeds characterized by high fecundity and fast growth.</skos:definition>
    <era:status>unknown</era:status>
  </rdf:Description>
