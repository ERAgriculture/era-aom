  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000238">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/8330"/>
    <skos:relatedMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_330618"/>
    <skos:relatedMatch rdf:resource="http://opendata.inra.fr/EOL/EOL_0000117"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Crude Fibre</skos:prefLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">A measurement of fibre content. Also known as Weende cellulose, crude fibre is the insoluble residue of an acid hydrolysis followed by an alkaline one. This residue contains true cellulose and insoluble lignin. It is also used to assess hair, hoof or feather residues in animal by-products. Even though the more accurate Van Soest analysis has superseded it since the 1970s, the analysis of crude fibre remains common in feed laboratories. Source: Feedipedia</skos:definition>
    <skos:notation>AOM_000238</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000154">
    <era:status>unknown</era:status>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000152"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Improved Breeds</skos:prefLabel>
    <skos:definition xml:lang="en">The use of improved animal breeds, these are animals bred for specific traits usually productivity (typically breeds exotic to Africa like Friesen, Holstein or Jersey cows).</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_000154</skos:notation>
