  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000005">
    <skos:prefLabel xml:lang="en">Bovine</skos:prefLabel>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FOODON_03414374"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9913"/>
    <skos:notation>AOM_000005</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The biological subfamily *Bovinae* includes a diverse group of 10 genera of medium- to large-sized ungulates, including domestic cattle, the bison, African buffalo, the water buffalo, the yak, and the four-horned and spiral-horned antelopes. The evolutionary relationship between the members of the group is obscure, and their classification into loose tribes rather than formal subgroups reflects this uncertainty. General characteristics include cloven hoofs and usually at least one of the sexes of a species having true horns.</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000004"/>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000009"/>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000015"/>
  </rdf:Description>
