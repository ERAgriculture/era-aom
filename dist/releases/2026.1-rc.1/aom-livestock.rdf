  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000239">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/8329"/>
    <skos:relatedMatch rdf:resource="http://www.cropontology.org/rdf/CO_345:0000016"/>
    <skos:relatedMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_330614"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <skos:prefLabel xml:lang="en">Crude Protein</skos:prefLabel>
    <skos:notation>AOM_000239</skos:notation>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A measurement of protein content. In animal feeds, crude protein is calculated as mineral nitrogen x 6.25 (the assumption is that proteins of typical animal feeds contain 16% nitrogen in average). The mineral nitrogen value is obtained by the Kjeldahl method, or by a method giving similar results after correction, such as the Dumas method. Source: Feedipedia</skos:definition>
  </rdf:Description>
