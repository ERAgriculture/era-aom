  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000290">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:definition xml:lang="en">In sacco is a term used specifically for the nylon or Dacron bag technique, which involves placing a feed sample in a porous bag and incubating it in the animal's rumen. It is a hybrid approach, as the experiment takes place within the live animal (like in vivo) but uses an artificial containment system (like in vitro).  In the context of feed digestibility, in situ is often used interchangeably with in sacco, as both terms describe the nylon or Dacron bag technique. However, in situ can also refer to other experimental approaches, not just the nylon bag technique, that are performed in their natural environment or location. (HV GPT4).</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000300"/>
    <skos:altLabel xml:lang="en">Dacron Bag Technique</skos:altLabel>
    <skos:altLabel xml:lang="en">Nylon Bag Technique</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_000290</skos:notation>
    <skos:prefLabel xml:lang="en">In sacco</skos:prefLabel>
    <era:status>unknown</era:status>
  </rdf:Description>
