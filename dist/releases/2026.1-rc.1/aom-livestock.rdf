    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">Partial nitrogen balance of a crop product component (e.g., grain). Formula = N.product/N.input.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
