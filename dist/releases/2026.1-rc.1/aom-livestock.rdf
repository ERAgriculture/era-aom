  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000131">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An experimental diet contains more prebiotic supplements than a control diet. Prebiotics are non-digestible fibers that promote the growth of beneficial bacteria in the gut, helping to improve digestion and immune function (human validated ChatGPT).</skos:definition>
