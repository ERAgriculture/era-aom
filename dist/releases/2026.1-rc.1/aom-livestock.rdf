  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000270">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000270</skos:notation>
    <skos:prefLabel xml:lang="en">Total Phenols</skos:prefLabel>
    <skos:definition xml:lang="en">Any measurable characteristic related to the sum of phenols (CHEBI:15882) in feed. Total phenols represent the collective amount of phenolic compounds, including tannins, present in animal feeds. Phenolic compounds are secondary metabolites in plants and may possess antioxidant properties. The total phenol content can influence the nutritional quality, palatability, and digestibility of feedstuffs, as well as potentially exerting various physiological effects on the animals consuming th</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000088">
    <era:status>unknown</era:status>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12645"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3900"/>
