  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000252">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_000252</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <skos:definition xml:lang="en">Any measurable or observable characteristics related to the concentration of lignin (CHEBI:6457) in feed. Lignin is a complex organic polymer and a major structural component of plant cell walls. It provides rigidity and strength to plants, but in animal feeds, it is considered an anti-nutritional factor due to its indigestibility, reducing overall feed quality and nutrient availability. (HV GPT4)</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Lignin</skos:prefLabel>
  </rdf:Description>
