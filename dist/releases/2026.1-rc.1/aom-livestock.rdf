  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000024">
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000003"/>
    <era:status>unknown</era:status>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Poultry or Game Bird</skos:prefLabel>
    <skos:definition xml:lang="en">Poultry are domesticated birds kept by humans for their eggs, their meat or their feathers. These birds are most typically members of the superorder Galloanserae (fowl), especially the order Galliformes (which includes chickens, quails, and turkeys). The term also includes birds that are killed for their meat, such as the young of pigeons (known as squabs). Game birds are similar wild birds hunted for sport or food [https://en.wikipedia.org/wiki/Poultry].</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000024</skos:notation>
    <skos:altLabel xml:lang="en">Fowl</skos:altLabel>
    <skos:altLabel xml:lang="en">Game Birds</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8782"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411563"/>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000026"/>
