  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_002133">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_002133</skos:notation>
    <skos:definition xml:lang="en">A feed material with governed source identity “jatropha curcas” and characteristics: processing method — Defatting, Grinding.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_100958"/>
    <era:status>unknown</era:status>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_180498"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/18969"/>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:prefLabel xml:lang="en">Jatropha curcas Cake Defatted Ground</skos:prefLabel>
    <skos:altLabel xml:lang="en">Jatropha curcas Seed De-oiled Meal</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_001938">
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9031"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12474"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_100983"/>
    <skos:notation>AOM_001938</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Chicken Viscera Dried Ground</skos:altLabel>
    <skos:altLabel xml:lang="en">Chicken Offal Dried Milled</skos:altLabel>
    <skos:altLabel xml:lang="en">Chicken Offal Dried Meal</skos:altLabel>
    <skos:prefLabel xml:lang="en">Chicken Offal Dried Ground</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">A feed material with governed source identity “chicken offal” and characteristics: processing method — Drying, Grinding.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000297">
    <skos:notation>AOM_000297</skos:notation>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">True Digestibility takes into account the endogenous losses of nutrients, which are the nutrients excreted by the animal from sources other than the diet, such as metabolic processes and secretions from the digestive system. By correcting for these endogenous losses, true digestibility provides a more accurate representation of the actual utilization of the feed's nutrients by the animal. (HV GPT4)</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000298"/>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Total Collection Technique (True)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_001627">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_002112"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_001627</skos:notation>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3983"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12805"/>
    <era:status>unknown</era:status>
    <skos:prefLabel xml:lang="en">Cassava Peel Dried</skos:prefLabel>
    <skos:definition xml:lang="en">A feed material with governed source identity “cassava” and characteristics: ingredient part — Peel; processing method — Drying.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000819">
    <skos:notation>AOM_000819</skos:notation>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:status>unknown</era:status>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Alkali Treatment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_100991"/>
    <skos:definition xml:lang="en">Alkali treatment is an feed processing technique that involves the application of alkaline substances to raw feed materials, primarily to enhance the digestibility of fibrous components. This process typically uses alkaline agents, such as sodium hydroxide, potassium hydroxide, or ammonia, which can solubilize hemicellulose, lignin, and other complex carbohydrates, improving the overall nutritional value of fibrous feedstuffs. (HV GPT4)</skos:definition>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_100848"/>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000817"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000758">
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000779"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Iodated Salt</skos:prefLabel>
    <skos:definition xml:lang="en">A feed-supplement ingredient with governed workbook identity “Iodated Salt”, classified within “Mineral”. Component, processing method, physical form, product role, integrity, composition, and constituent are unspecified unless separately asserted.</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:altLabel xml:lang="en">Iodized Salt</skos:altLabel>
    <skos:notation>AOM_000758</skos:notation>
  </rdf:Description>
