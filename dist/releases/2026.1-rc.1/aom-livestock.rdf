    <skos:definition xml:lang="en">Feed materials derived from Harrisonia abyssinica, grouped independently of plant-part and processing state.</skos:definition>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_002090"/>
  </rdf:Description>
