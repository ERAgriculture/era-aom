    <skos:notation>AOM_001411</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12233"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_173850"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_001409"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">A feed material with governed source identity “pennisetum clandestinum” and characteristics: processing method — Grinding.</skos:definition>
    <skos:prefLabel xml:lang="en">Pennisetum clandestinum Ground</skos:prefLabel>
    <skos:altLabel xml:lang="en">Pennisetum clandestinum Milled</skos:altLabel>
    <skos:altLabel xml:lang="en">Pennisetum clandestinum Meal</skos:altLabel>
