  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000063">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/12365"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_59786"/>
    <skos:prefLabel xml:lang="en">Napier Grass</skos:prefLabel>
    <skos:altLabel xml:lang="en">Elephant Grass</skos:altLabel>
    <skos:altLabel xml:lang="en">Bana Grass</skos:altLabel>
    <skos:altLabel xml:lang="en">Uganda Grass</skos:altLabel>
    <skos:altLabel xml:lang="en">Barner Grass</skos:altLabel>
    <skos:altLabel xml:lang="en">Napier</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000058"/>
    <skos:definition xml:lang="en">Elephant grass (Pennisetum purpureum Schumach.) is a major tropical grass. It is one of the highest yielding tropical grasses. It is a very versatile species that can be grown under a wide range of conditions and systems: dry or wet conditions, smallholder or larger scale agriculture. It is a valuable forage and very popular throughout the tropics, notably in cut-and-carry systems (Mannetje, 1992; FAO, 2015). [Feedipedia]</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_000063</skos:notation>
    <era:status>unknown</era:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_001570">
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000734"/>
    <skos:definition xml:lang="en">A forage-plant feed material with governed source identity “atractylis cancellata”. Component, processing method, physical form, product role, integrity, composition, and constituent are unspecified at this concept level unless separately asserted.</skos:definition>
    <skos:notation>AOM_001570</skos:notation>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_143173"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Atractylis cancellata</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000248">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Hemicellulose</skos:prefLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000196"/>
    <skos:notation>AOM_000248</skos:notation>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">Any measurable or observable characteristics related to the concentration of hemicellulose (CHEBI:61266) in feed. Hemicellulose is a heterogeneous group of polysaccharides found in plant cell walls. In animal feeds, hemicellulose contributes to dietary fiber and is more easily broken down than cellulose, making it a source of fermentable carbohydrates for ruminants and other animals with specialized digestive systems. (HV GPT4)</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000166">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000164"/>
    <skos:prefLabel xml:lang="en">Improved Pasture- Grasses</skos:prefLabel>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">The planting of pastures with non-leguminous forages.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000166</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000132">
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000120"/>
    <skos:definition xml:lang="en">An experimental diet contains more essential fatty acid supplements than a control diet. Essential fatty acids include omega-3 (CHEBI_25681) amd omega-6 (CHEBI_36009).</skos:definition>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/MAXO_0010024"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">essential fatty acid supplementation</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_000132</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000031">
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <era:status>unknown</era:status>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000024"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_93934"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411346"/>
    <skos:notation>AOM_000031</skos:notation>
    <skos:definition xml:lang="en">A species of Old World quail found in East Asia. First considered a subspecies of the common quail, it was distinguished as its own species in 1983. As the Japanese quail is easily managed, fast growing, small in size, and can produce eggs at a high rate, it has been farmed in large quantities across the globe.</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Japanese Quail</skos:prefLabel>
  </rdf:Description>
