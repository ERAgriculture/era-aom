  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000085">
    <skos:prefLabel xml:lang="en">Guinea Grass</skos:prefLabel>
    <skos:altLabel xml:lang="en">Tanganyika Grass</skos:altLabel>
    <skos:altLabel xml:lang="en">Panicum maximum var. coloratum</skos:altLabel>
    <skos:altLabel xml:lang="en">Panicum maximum</skos:altLabel>
    <skos:altLabel xml:lang="en">Panicum maximum var. pubiglume</skos:altLabel>
    <skos:altLabel xml:lang="en">Panicum maximum var. hirsutissimum</skos:altLabel>
    <skos:altLabel xml:lang="en">Buffalo Grass</skos:altLabel>
    <skos:altLabel xml:lang="en">Panicum hirsutissimum</skos:altLabel>
    <skos:altLabel xml:lang="en">Urochloa maxima</skos:altLabel>
    <skos:altLabel xml:lang="en">Panicum maximum var. trichoglume</skos:altLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/11521"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_59788"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000058"/>
    <skos:notation>AOM_000085</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">Guinea grass (Megathyrsus maximus (Jacq.) B. K. Simon &amp; S. W. L. Jacobs) is a major pantropical grass used throughout the tropics for pasture, cut-and-carry, silage and hay. It is a fast growing and leafy grass, which is palatable to livestock with a good nutritional value. However, it is generally recommended to supplement it with sources of protein in order to meet nutritional requirements or improve animal performance. [Feedipedia]</skos:definition>
    <era:status>unknown</era:status>
  </rdf:Description>
