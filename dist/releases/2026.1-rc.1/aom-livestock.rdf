    <skos:relatedMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_806be3ed"/>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Any measurable characteristic related to the concentration of cellulosic, hemicellulosic and lignin fractions of vegetal cell wall components in food. It could be declared by the manufacturer. Source: EOL</skos:definition>
  </rdf:Description>
