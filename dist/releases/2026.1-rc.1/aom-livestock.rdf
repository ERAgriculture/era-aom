  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000840">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:definition xml:lang="en">Pelleting is a feed processing technique that involves the compression of raw feed materials into small, dense, cylindrical shapes called pellets. This process typically involves a combination of grinding, mixing, and conditioning, followed by the use of a pellet mill to create uniform pellets. Pelleting can improve feed handling, storage, and intake, while reducing waste and enhancing nutrient utilization. (HV GPT4)</skos:definition>
    <skos:notation>AOM_000840</skos:notation>
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:prefLabel xml:lang="en">Pelleting</skos:prefLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000837"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
