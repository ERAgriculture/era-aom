  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000343">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <era:status>unknown</era:status>
    <skos:definition xml:lang="en">An ectoparasiticide is a chemical agent or substance used to control, repel, or kill ectoparasites, which are external parasites that infest the skin or outer surfaces of their host animals. Examples of ectoparasites include ticks, mites, fleas, and lice. Ectoparasiticides are commonly used in livestock production to maintain animal health, prevent the spread of diseases, and improve overall productivity. (HV GPT4)</skos:definition>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38956"/>
    <skos:prefLabel xml:lang="en">Ectoparasiticide</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:notation>AOM_000343</skos:notation>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000331"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
