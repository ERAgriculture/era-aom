  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000830">
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:prefLabel xml:lang="en">Fermentation</skos:prefLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000145"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_100990"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:notation>AOM_000830</skos:notation>
    <skos:definition xml:lang="en">Feed fermentation is a process of preserving animal feeds, such as grains or forage, by allowing them to undergo controlled microbial breakdown. This process can occur naturally, or it can be initiated by adding specific microbial cultures. During fermentation, the microorganisms convert some of the feed's carbohydrates and sugars into organic acids, such as lactic acid, which lower the pH and inhibit the growth of harmful bacteria. The resulting fermented feed has a higher concentration of beneficial nutrients, such as vitamins and amino acids, and is more easily digestible by livestock. (human validated chatGPT).</skos:definition>
    <skos:narrower rdf:resource="https://w3id.org/era-aom/livestock/AOM_000831"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_003202">
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_100991"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <skos:definition xml:lang="en">Molasses treatment involves applying molasses to fibrous feeds such as straw, stover, or hay to enhance palatability, increase energy content, and reduce dustiness. While it does not chemically alter fiber structure like alkali treatments, molasses provides readily fermentable carbohydrates that improve feed intake and support rumen microbial activity. It is often used as a carrier for urea or minerals in treated feeds and is widely adopted in both smallholder and commercial livestock systems for its ease of use and positive impact on voluntary intake.</skos:definition>
    <skos:notation>AOM_003202</skos:notation>
    <skos:prefLabel xml:lang="en">Molasses Treatment</skos:prefLabel>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
