  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000822">
    <skos:prefLabel xml:lang="en">Hemicellulase Treatment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_006824"/>
    <skos:definition xml:lang="en">Hemicellulase treatment: Hemicellulase treatment is a feed processing technique that incorporates hemicellulase enzymes into raw feed materials prior to ingestion by animals. These enzymes target hemicellulose, a complex carbohydrate present in plant cell walls, breaking it down into simpler components to enhance nutrient absorption and feed value. (HV GPT4)</skos:definition>
    <era:status>unknown</era:status>
    <skos:notation>AOM_000822</skos:notation>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
