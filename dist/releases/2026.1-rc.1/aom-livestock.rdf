    <skos:prefLabel xml:lang="en">multi-species</skos:prefLabel>
    <skos:definition xml:lang="en">system of farming which uses multiple species in the same rearing structure occupying different ecological niches of the medium to optimize production, with or without trophic interrelationship</skos:definition>
    <era:status>unknown</era:status>
    <skos:altLabel xml:lang="en">polyculture rearing system</skos:altLabel>
    <skos:altLabel xml:lang="en">poly-species rearing system</skos:altLabel>
