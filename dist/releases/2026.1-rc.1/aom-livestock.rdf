  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_003098">
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:prefLabel xml:lang="en">Sprouted</skos:prefLabel>
    <skos:definition xml:lang="en">A process in which grains or seeds are soaked and germinated under controlled moisture and temperature conditions to initiate sprouting. This enhances enzymatic activity, reduces anti-nutritional factors, and increases the bioavailability of certain nutrients, making the feed more digestible and nutritionally beneficial for livestock.</skos:definition>
    <era:status>unknown</era:status>
    <skos:notation>AOM_003098</skos:notation>
