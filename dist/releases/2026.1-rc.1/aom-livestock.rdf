  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000831">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/era-aom/schema/ProcessingMethod"/>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000830"/>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:altLabel xml:lang="en">Ensilation</skos:altLabel>
    <skos:altLabel xml:lang="en">Silage Process</skos:altLabel>
    <skos:altLabel xml:lang="en">Ensiled</skos:altLabel>
    <skos:notation>AOM_000831</skos:notation>
    <era:status>unknown</era:status>
    <skos:prefLabel xml:lang="en">Ensiling</skos:prefLabel>
    <skos:definition xml:lang="en">Ensilation is a specific form of fermentation to preserve forage by packing it tightly into a silo or other airtight container and allowing it to ferment. This fermentation process creates an anaerobic environment that preserves the feed and enhances its nutritional quality by increasing the concentration of organic acids and decreasing the pH. The resulting ensiled feed can be stored for extended periods of time and used as a source of nutrition for livestock. (human validated chatGPT)</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
  </rdf:Description>
