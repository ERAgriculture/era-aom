  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000075">
    <era:status>unknown</era:status>
    <skos:inScheme rdf:resource="https://w3id.org/era-aom/scheme/livestock-v2"/>
    <skos:altLabel xml:lang="en">Perennial Ryegrass</skos:altLabel>
    <skos:altLabel xml:lang="en">Lolium</skos:altLabel>
    <skos:altLabel xml:lang="en">Italian Ryegrass</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000058"/>
    <skos:notation>AOM_000075</skos:notation>
    <skos:prefLabel xml:lang="en">Ryegrass</skos:prefLabel>
    <skos:relatedMatch rdf:resource="https://www.feedipedia.org/node/625"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4520"/>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/FOODON_03413386"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The most important cultivated temperate grasses. Also grown in subtropical areas of Australia, S America and S Africa; in the tropics, ryegrass is grown to a limited extent at high altitudes, e.g. in Colombia or Kenya, ryegrass is grown above 2400-2500 m alt. Often sown in mixtures with white clover. L. multiflorum is less persistent, dying out after 2-3 years of productive growth. It withstands drier and hotter conditions better than L. perenne and in the tropics it can be grown at somewhat lower altitudes than the latter. [Feedipedia]</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
  </rdf:Description>
