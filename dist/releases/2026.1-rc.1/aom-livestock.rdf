  <rdf:Description rdf:about="https://w3id.org/era-aom/livestock/AOM_000826">
    <skos:prefLabel xml:lang="en">Thermal Process</skos:prefLabel>
    <skos:definition xml:lang="en">The process of applying heat to animal feed, typically through steam or direct heating, to improve its digestibility, increase nutrient availability, and reduce the presence of harmful microorganisms. This process may involve the use of various equipment, such as ovens, boilers, heaters, and dryers, and is often used in commercial feed production. (human validated chatGPT)</skos:definition>
    <era:conceptType>legacy_aom_concept</era:conceptType>
    <skos:broader rdf:resource="https://w3id.org/era-aom/livestock/AOM_000845"/>
