@prefix aom: <https://w3id.org/era-aom/schema/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/era-aom/schema> a owl:Ontology ;
    dcterms:description "OWL model separating AOM knowledge-organization concepts from agricultural observations, feed-material records, quantities, and governance provenance."@en ;
    dcterms:title "AOM semantic model"@en ;
    owl:versionInfo "design-1" .

aom:ChangeProposal a owl:Class ;
    rdfs:label "change proposal"@en .

aom:FeedAdditive a owl:Class ;
    rdfs:label "feed additive"@en ;
    rdfs:subClassOf aom:Feed .

aom:GestationalStage a owl:Class ;
    rdfs:label "gestational stage"@en ;
    rdfs:subClassOf skos:Concept .

aom:IngredientBulkConsistency a owl:Class ;
    rdfs:label "ingredient bulk consistency"@en ;
    rdfs:subClassOf aom:FeedBulkConsistency ;
    owl:deprecated true .

aom:IngredientMoistureCondition a owl:Class ;
    rdfs:label "ingredient moisture condition"@en ;
    rdfs:subClassOf aom:FeedMoistureCondition ;
    owl:deprecated true .

aom:IngredientPartCategory a owl:Class ;
    rdfs:label "ingredient part category"@en ;
    rdfs:subClassOf aom:FeedMaterialPartCategory ;
    owl:deprecated true .

aom:IngredientPhysicalForm a owl:Class ;
    rdfs:label "ingredient physical descriptor"@en ;
    rdfs:subClassOf aom:FeedPhysicalDescriptor ;
    owl:deprecated true .

aom:IngredientPresentationForm a owl:Class ;
    rdfs:label "ingredient presentation form"@en ;
    rdfs:subClassOf aom:FeedPresentationForm ;
    owl:deprecated true .

aom:MappingAssertion a owl:Class ;
    rdfs:label "mapping assertion"@en .

aom:ParityStatus a owl:Class ;
    rdfs:label "parity status"@en ;
    rdfs:subClassOf skos:Concept .

aom:QuantitativeObservation a owl:Class ;
    rdfs:label "quantitative observation"@en ;
    rdfs:subClassOf sosa:Observation .

aom:bindingAction a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticValueBinding ;
    rdfs:range xsd:string .

aom:bindingKind a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticBinding ;
    rdfs:range xsd:string .

aom:bindingStatus a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticBinding ;
    rdfs:range xsd:string .

aom:bulkConsistency a owl:ObjectProperty ;
    rdfs:label "has bulk consistency"@en ;
    rdfs:domain aom:Feed ;
    rdfs:range aom:FeedBulkConsistency ;
    rdfs:subPropertyOf aom:physicalForm .

aom:compatibilityPolicy a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticBinding ;
    rdfs:range xsd:string .

aom:compositionState a owl:ObjectProperty ;
    rdfs:label "has composition state"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:CompositionState .

aom:feedProductType a owl:ObjectProperty ;
    rdfs:label "has feed product type"@en ;
    rdfs:domain aom:Feed ;
    rdfs:range aom:FeedProductType .

aom:hasIngredientComponent a owl:ObjectProperty ;
    rdfs:domain aom:FeedFormulation ;
    rdfs:range aom:IngredientComponent .

aom:inModule a owl:ObjectProperty ;
    rdfs:range aom:Module .

aom:ingredientConstituent a owl:ObjectProperty ;
    rdfs:label "has ingredient constituent"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:IngredientConstituent ;
    rdfs:subPropertyOf aom:primaryConstituent ;
    owl:deprecated true .

aom:ingredientMaterial a owl:ObjectProperty ;
    rdfs:domain aom:IngredientComponent ;
    rdfs:range aom:FeedMaterial .

aom:ingredientName a owl:DatatypeProperty ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range xsd:string .

aom:ingredientPart a owl:ObjectProperty ;
    rdfs:label "has ingredient part"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:FeedMaterialPartCategory ;
    rdfs:subPropertyOf aom:materialComponent .

aom:ingredientProportion a owl:ObjectProperty ;
    rdfs:domain aom:IngredientComponent ;
    rdfs:range qudt:QuantityValue .

aom:ingredientSource a owl:ObjectProperty ;
    rdfs:label "has ingredient source"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:IngredientSourceCategory .

aom:legacyComponentDescriptor a owl:DatatypeProperty ;
    rdfs:comment "Unmodified legacy component descriptor retained until reviewed decomposition into explicit facets."@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range xsd:string .

aom:legacyConcept a owl:ObjectProperty ;
    rdfs:domain aom:SemanticBinding ;
    rdfs:range skos:Concept .

aom:materialIntegrity a owl:ObjectProperty ;
    rdfs:label "has material integrity"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:MaterialIntegrity .

aom:mayResultInMoistureCondition a owl:ObjectProperty ;
    rdfs:label "may result in moisture condition"@en ;
    rdfs:comment "Links a processing method to a possible moisture condition without asserting that every material undergoing that process has that result."@en ;
    rdfs:domain aom:ProcessingMethod ;
    rdfs:range aom:FeedMoistureCondition ;
    rdfs:subPropertyOf aom:mayResultInPhysicalForm .

aom:mayResultInPresentationForm a owl:ObjectProperty ;
    rdfs:label "may result in presentation form"@en ;
    rdfs:comment "Links a processing method to a possible presentation without asserting that every use has that result or a narrower subtype."@en ;
    rdfs:domain aom:ProcessingMethod ;
    rdfs:range aom:FeedPresentationForm ;
    rdfs:subPropertyOf aom:mayResultInPhysicalForm .

aom:moistureCondition a owl:ObjectProperty ;
    rdfs:label "has moisture condition"@en ;
    rdfs:domain aom:Feed ;
    rdfs:range aom:FeedMoistureCondition ;
    rdfs:subPropertyOf aom:physicalForm .

aom:presentationForm a owl:ObjectProperty ;
    rdfs:label "has presentation form"@en ;
    rdfs:domain aom:Feed ;
    rdfs:range aom:FeedPresentationForm ;
    rdfs:subPropertyOf aom:physicalForm .

aom:processingMethod a owl:ObjectProperty ;
    rdfs:label "has processing method"@en ;
    rdfs:domain aom:Feed ;
    rdfs:range aom:ProcessingMethod .

aom:productRole a owl:ObjectProperty ;
    rdfs:label "has product role"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:ProductRole .

aom:quantityKind a owl:ObjectProperty ;
    rdfs:domain aom:SemanticBinding .

aom:releasedIn a owl:ObjectProperty ;
    rdfs:range aom:Release .

aom:reviewedBy a owl:ObjectProperty ;
    rdfs:range aom:Reviewer .

aom:sourceTaxon a owl:ObjectProperty ;
    rdfs:label "has biological species"@en ;
    rdfs:comment "Links feed material to a reviewed taxon IRI; does not imply SKOS identity."@en ;
    rdfs:domain aom:FeedMaterial .

aom:sourceValue a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticValueBinding ;
    rdfs:range xsd:string .

aom:supportedBy a owl:ObjectProperty ;
    rdfs:range aom:Evidence ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

aom:targetClass a owl:ObjectProperty ;
    rdfs:domain aom:SemanticBinding .

aom:targetProperty a owl:ObjectProperty ;
    rdfs:domain aom:SemanticBinding .

aom:targetValueClass a owl:ObjectProperty ;
    rdfs:domain aom:SemanticValueBinding .

aom:unitRequirement a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticBinding ;
    rdfs:range xsd:string .

aom:valueBindingStatus a owl:DatatypeProperty ;
    rdfs:domain aom:SemanticValueBinding ;
    rdfs:range xsd:string .

aom:valueClass a owl:ObjectProperty ;
    rdfs:domain aom:SemanticBinding .

aom:valueTargetConcept a owl:ObjectProperty ;
    rdfs:domain aom:SemanticValueBinding ;
    rdfs:range skos:Concept .

aom:valueTargetProperty a owl:ObjectProperty ;
    rdfs:domain aom:SemanticValueBinding .

aom:CompositionState a owl:Class ;
    rdfs:label "composition state"@en ;
    rdfs:comment "Governed compositional state of a feed material, independently of physical form."@en ;
    rdfs:subClassOf skos:Concept .

aom:Evidence a owl:Class ;
    rdfs:label "evidence"@en ;
    rdfs:subClassOf prov:Entity .

aom:FeedFormulation a owl:Class ;
    rdfs:label "feed formulation"@en ;
    rdfs:comment "A feed represented as a formulated mixture or ration; component materials and proportions require explicit assertions."@en ;
    rdfs:subClassOf aom:Feed .

aom:FeedProductType a owl:Class ;
    rdfs:label "feed product type"@en ;
    rdfs:comment "Product category arising from production, formulation, or conservation, independently of physical form and processing method."@en ;
    rdfs:subClassOf skos:Concept .

aom:IngredientConstituent a owl:Class ;
    rdfs:label "ingredient constituent"@en ;
    rdfs:subClassOf aom:ChemicalConstituent ;
    owl:deprecated true .

aom:IngredientSourceCategory a owl:Class ;
    rdfs:label "ingredient source category"@en ;
    rdfs:subClassOf skos:Concept .

aom:MaterialIntegrity a owl:Class ;
    rdfs:label "material integrity"@en ;
    rdfs:comment "Compositional integrity retained by a material independently of particle form or processing."@en ;
    rdfs:subClassOf skos:Concept .

aom:Module a owl:Class ;
    rdfs:label "module"@en .

aom:ProductRole a owl:Class ;
    rdfs:label "product role"@en ;
    rdfs:subClassOf skos:Concept .

aom:Release a owl:Class ;
    rdfs:label "release"@en .

aom:Reviewer a owl:Class ;
    rdfs:label "reviewer"@en ;
    rdfs:subClassOf prov:Agent .

aom:materialComponent a owl:ObjectProperty ;
    rdfs:label "has material component"@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:FeedMaterialComponent .

aom:primaryConstituent a owl:ObjectProperty ;
    rdfs:label "has primary chemical constituent"@en ;
    rdfs:comment "Identifies a chemically defined constituent central to material identity; it does not represent an ingredient in a formulated feed."@en ;
    rdfs:domain aom:FeedMaterial ;
    rdfs:range aom:ChemicalConstituent .

aom:ChemicalConstituent a owl:Class ;
    rdfs:label "chemical constituent"@en ;
    rdfs:subClassOf skos:Concept .

aom:FeedBulkConsistency a owl:Class ;
    rdfs:label "feed bulk consistency"@en ;
    rdfs:comment "Bulk flow or dispersion consistency independently of particle presentation and moisture condition."@en ;
    rdfs:subClassOf aom:FeedPhysicalDescriptor .

aom:FeedMaterialComponent a owl:Class ;
    rdfs:label "feed material component"@en ;
    rdfs:comment "Reviewed material scope or component, including anatomical parts and collective material such as a whole crop."@en ;
    rdfs:subClassOf skos:Concept .

aom:FeedMaterialPartCategory a owl:Class ;
    rdfs:label "feed-material part category"@en ;
    rdfs:subClassOf skos:Concept,
        aom:FeedMaterialComponent .

aom:mayResultInPhysicalForm a owl:ObjectProperty ;
    rdfs:label "may result in physical descriptor"@en ;
    rdfs:comment "Deprecated compatibility property; use an axis-specific process-result property."@en ;
    rdfs:domain aom:ProcessingMethod ;
    rdfs:range aom:FeedPhysicalDescriptor ;
    owl:deprecated true .

aom:FeedMoistureCondition a owl:Class ;
    rdfs:label "feed moisture condition"@en ;
    rdfs:comment "Qualitative moisture condition independently of presentation and bulk consistency."@en ;
    rdfs:subClassOf aom:FeedPhysicalDescriptor .

aom:FeedPresentationForm a owl:Class ;
    rdfs:label "feed presentation form"@en ;
    rdfs:comment "Shape or particle presentation independently of bulk consistency and moisture condition."@en ;
    rdfs:subClassOf aom:FeedPhysicalDescriptor .

aom:IngredientComponent a owl:Class ;
    rdfs:label "ingredient component"@en ;
    rdfs:comment "A feed material used in a formulation, optionally with a quantitative proportion."@en .

aom:physicalForm a owl:ObjectProperty ;
    rdfs:label "has physical descriptor"@en ;
    rdfs:comment "Deprecated compatibility property; use presentationForm, bulkConsistency, or moistureCondition."@en ;
    rdfs:domain aom:Feed ;
    rdfs:range aom:FeedPhysicalDescriptor ;
    owl:deprecated true .

aom:ProcessingMethod a owl:Class ;
    rdfs:label "processing method"@en ;
    rdfs:subClassOf skos:Concept .

aom:FeedPhysicalDescriptor a owl:Class ;
    rdfs:label "feed physical descriptor"@en ;
    rdfs:comment "Compatibility superclass for independently governed presentation, bulk-consistency, and moisture-condition descriptors."@en ;
    rdfs:subClassOf skos:Concept .

aom:SemanticValueBinding a owl:Class ;
    rdfs:label "semantic value binding"@en ;
    rdfs:comment "Governed decision mapping a source controlled value to an ontology concept or explicitly holding it unresolved."@en .

aom:Feed a owl:Class ;
    rdfs:label "feed"@en ;
    rdfs:comment "A material, formulation, or additive represented for animal feeding."@en .

aom:SemanticBinding a owl:Class ;
    rdfs:label "semantic binding"@en ;
    rdfs:comment "Governed migration contract connecting a legacy AOM concept to its normalized data-model use."@en .

aom:FeedMaterial a owl:Class ;
    rdfs:label "feed material"@en ;
    rdfs:comment "A material used or evaluated as feed. Source organism, part, processing method, and economic product role are modeled as facets."@en ;
    rdfs:subClassOf aom:Feed .

