<urn:era:outcome:232.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Water Use"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "232.1" ;
  skos:altLabel "WU"@en ;
  skos:definition "Water used per area to produce crops."@en ;
  skos:scopeNote "Use the units to note any complexities, in particular if the water use is only referring to irrigation water being used in irrgation experiments."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:232.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Water Use Efficiency"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "232.2" ;
  skos:altLabel "WUE"@en ;
  skos:definition "Product produced or economic yield per unit water (includes rainfall)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
