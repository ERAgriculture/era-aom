<urn:era:outcome:267.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Feed Conversion Ratio (Out In)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "267.0" ;
  skos:altLabel "FCR (Out In)"@en ;
  skos:definition "Ratio of Weight Gained to Feed Given."@en ;
  skos:scopeNote "This outcome relates to animal feed experiments. This is a ratio whose value should be less than 1 (although some aquatic experiment may yield slightly >1 if there are other food resources available in the water, like algae). Units can be absent as the outcome is a ratio."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
