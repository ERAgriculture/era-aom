<urn:era:outcome:233.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (ARE Unspecificed)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.0" ;
  skos:altLabel "NUE (ARE Unsp.)"@en ;
  skos:definition "Apparent N recovery efficiency. Use this code if it is unclear whether above-ground biomass or a sub-component (e.g. grain) was used in calculations. Formula for a zero N control = (N.trt - N.cont)/N input, otherwise Formula = (N.Out.trt - N.Out.cont)/(N.Input.trt - N.Input.Cont)."@en ;
  skos:scopeNote "Outcome is a ratio. The control is often a zero N treatment where no nitrogen fertilizer was added. Note that to compare two the ARE of two different treatments then they must share the same control."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:233.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (ARE Product)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.1" ;
  skos:altLabel "NUE (ARE Prod)"@en ;
  skos:definition "Apparent N recovery efficiency in crop product component (e.g. grain). Formula for a zero N control = (N.treatment - N.control)/N input, otherwise Formula = (N.Out.trt - N.Out.cont)/(N.In.trt - N.In.Cont).\n"@en ;
  skos:scopeNote "Outcome is a ratio. The control is often a zero N treatment where no nitrogen fertilizer was added. Note that to compare two the ARE of two different treatments then they must share the same control."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:233.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (ARE AGB)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.2" ;
  skos:altLabel "NUE (ARE AGB)"@en ;
  skos:definition "Apparent N recovery efficiency in crop above ground biomass (the whole plant, grain + biomass). Formula for a zero N control = (N.treatment - N.control)/N input, otherwise Formula = (N.Out.trt - N.Out.cont)/(N.In.trt - N.In.Cont)."@en ;
  skos:scopeNote "Outcome is a ratio. The control is often a zero N treatment where no nitrogen fertilizer was added. Note that to compare two the ARE of two different treatments then they must share the same control."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:233.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (Isotopic Product)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.3" ;
  skos:altLabel "NUE (Iso Prod)"@en ;
  skos:definition "Nitrogen use efficiency of a crop product component (e.g., grain) measured using nitrogen-15 stable isotope methods. Formula =15N/N.input. The product component of the crop is used (e.g., grain)."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:233.4> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (Isotopic AGB)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.4" ;
  skos:altLabel "NUE (Iso AGB)"@en ;
  skos:definition "Nitrogen use efficiency of aboveground biomass (the whole plant, grain + biomass) measured using nitrogen-15 stable isotope methods. Formula =15N/N.input."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:233.5> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (PNB Product)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.5" ;
  skos:altLabel "NUE (PNB Prod)"@en ;
  skos:definition "Partial nitrogen balance of a crop product component (e.g., grain). Formula = N.product/N.input."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:233.6> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Use Efficiency (PNB AGB)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "233.6" ;
  skos:altLabel "NUE (PNB AGB)"@en ;
  skos:definition "Partial nitrogen balance for crop aboveground biomass (the whole plant, grain + biomass). Formula = N.AGB/N.input."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:257.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Agronomic Efficiency"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "257.1" ;
  skos:altLabel "N AE (Prod)"@en ;
  skos:definition "The yield change in the crop product component (e.g. grain) of the treatment compared to the control, per unit of nitrogen input. Formula = (Yt -Yc)/N. Also called Agronomic Effectiveness."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:257.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Agronomic Efficiency (AGB)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "257.3" ;
  skos:altLabel "N AE (AGB)"@en ;
  skos:definition "The yield change in aboveground biomass (the whole plant, grain + biomass) of the treatment compared to the control, per unit of nitrogen input. Formula = (Yt -Yc)/N. Also called Agronomic Effectiveness."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:257.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen Factor Productivity"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "257.2" ;
  skos:altLabel "N TFP"@en ;
  skos:definition "Crop yield divided by amount of nitrogen applied (Yield/N)."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
<urn:era:outcome:238.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrogen (Apparent Efficiency Animals Feed)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "238.0" ;
  skos:altLabel "Nitrogen (AE Animals)"@en ;
  skos:altLabel "Nitrogen (Apparent Efficiency)"@en ;
  skos:definition "Animal Products Only. Integration of N into production. Formula = N.retained/N.supplied."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio. To compare two treatments they should share the same inputs, but have different management (for example)."@en ;
  skos:broader <urn:era:outcome:indicator:012> .
