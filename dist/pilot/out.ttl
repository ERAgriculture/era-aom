  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Labour Person Hours"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "132.0" ;
  skos:altLabel "Labour (Person Hours)"@en ;
  skos:definition "Labour time per task, season, or unit land (gender is not specified)."@en ;
  skos:broader <urn:era:outcome:indicator:014> .
<urn:era:outcome:133.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Return to Labour"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "133.0" ;
  skos:altLabel "Returns to Labour"@en ;
  skos:definition "Return to Labour or Labour Productivity. This may be expressed as income/day labour, income/area or production/day labour."@en ;
  skos:scopeNote "Make sure units are carefully recorded and this is not the cost of labour, which should be recorded under Economics: Cost of Labour outcome."@en ;
