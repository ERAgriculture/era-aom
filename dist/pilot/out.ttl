<urn:era:outcome:101.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Crop Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "101.0" ;
  skos:definition "Amount of crop plant product produced (e.g., grain or fruit yield) per unit area land."@en ;
  skos:scopeNote "When product and non-product components are not separated, for example measures of total, above-ground or below-ground crop biomass, the outcome sould be recorded using the Biomass Yield Outcome. Non-product component outcomes (e.g. maize stover or wheat stalks) should be recorded using the Crop Residue Yield outcome."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:101.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Biomass Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "101.1" ;
  skos:definition "Plant biomass yield. This can be used to describe pasture biomass yields or when total, above ground, or below ground biomass yields are given for crops that are usually split into product and non-product parts on harvest."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:101.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Extraction Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "101.2" ;
  skos:definition "Extraction yield of oil from oil seeds or similar. For example 300kg oil extracted from 1000kg oil seeds = 0.3 or 30% oil yield per kg oil seeds."@en ;
  skos:scopeNote "This outcome should be a percentage or ratio."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:103.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Land Equivalent Ratio"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "103.0" ;
  skos:altLabel "LER"@en ;
  skos:definition "The land equivalent ratio describes the relative land area required under sole cropping (monoculture) to produce the same yield as under intercropping (polyculture)."@en ;
  skos:scopeNote "We do not accept LER for practice A vs practice B (e.g. mulch vs no-mulch as this yield A/yield B, which we calculated as the response ratio)."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:104.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Area Time Equivalent Ratio"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "104.0" ;
  skos:altLabel "ATER"@en ;
  skos:definition "The Area Time Equivalent Ratio (ATER) is a measure of the productivity of an intercropping system. It is calculated by dividing the total yield of the intercrop by the yield of a sole crop grown for the same duration. The ATER is calculated as follows: ATER = (Total yield of intercrop) / (Yield of sole crop grown for the same duration). The ATER is particularly useful in intercropping systems where the crops have different growth durations. For example, if a farmer intercrops a fast-growing crop with a slow-growing crop, the faster-growing crop will produce a yield before the slower-growing crop. The ATER will take into account the different growth durations of the crops and will give a more accurate measure of the overall productivity of the intercropping system."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:118.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Weight Gain"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "118.0" ;
  skos:definition "Change in animal weight relative to a baseline (usually weight at the start of an experiment) over a specified time period."@en ;
  skos:scopeNote "Please try to standardise to g per animal per day (g/individual/day). Default unit is unit/individual (e.g kg/cow) unless otherwise stated. Values for this outcome can be negative (the animal loses weight) or positive."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:119.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Meat Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "119.1" ;
  skos:definition "The total weight of the animal or meat parts of it."@en ;
  skos:scopeNote "This should not be an increase from a baseline weight (this is recorded under the Weight Gain outcome). Please try and standardise units kg/individual, you may specify the type of meat or weight measurement though (e.g. carcass weight kg/individual).' Specify if carcass is hot or cold, take both if given;Default unit is unit/individual (e.g kg/cow) unless otherwise statement"@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:119.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Milk Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "119.2" ;
  skos:definition "Milk yields. Please specify absolute values and not change in yield relative to a base value."@en ;
  skos:scopeNote "Please try and standardise to litres per animal per day (l/individual/day)."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:119.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Egg Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "119.3" ;
  skos:definition "Egg yields, such as number of eggs per hen(s) per day(s)."@en ;
  skos:scopeNote "Please try and standardise units to eggs per one individual per day. (eggs/individual/day)."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:119.4> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Other Animal Product Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "119.4" ;
  skos:altLabel "Animal Yield (Other)"@en ;
  skos:definition "Animal products that are not meat, egg, milk or offsping, for example wool, hides and honey."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:119.5> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Reproductive Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "119.5" ;
  skos:altLabel "Repro Yield"@en ;
  skos:definition "Number of offpsring produced. This also includes % calving rate or similar."@en ;
  skos:broader <urn:era:outcome:indicator:001> .
<urn:era:outcome:400.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Feed Intake"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "400.0" ;
  skos:definition "The amount of a diet consumed per unit time."@en ;
  skos:broader <urn:era:outcome:indicator:002> .
<urn:era:outcome:102.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Crop Residue Yield"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "102.0" ;
  skos:altLabel "Residue Yield"@en ;
  skos:definition "Crop residue yield is the amount of crop biomass left over once the crop products has been harvested. For example maize grain is a crop product, the stover and cobs leftover after harvesting the maize grain are crop residues."@en ;
  skos:scopeNote "Entire plant biomass can also be recorded under this outcome if product or biomass yields are not available ( make sure the unit reflects this)."@en ;
  skos:broader <urn:era:outcome:indicator:003> .
<urn:era:outcome:120.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Gross Return"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "120.0" ;
  skos:definition "Total income, revenue or returns without consideration of costs."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units."@en ;
  skos:broader <urn:era:outcome:indicator:004> .
<urn:era:outcome:124.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Net Return"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "124.0" ;
  skos:definition "Net returns = income - total costs. Values for this outcome can be negative or positive."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units."@en ;
  skos:broader <urn:era:outcome:indicator:004> .
<urn:era:outcome:124.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Gross Margin"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "124.1" ;
  skos:definition "Gross margin = revenue - variable costs. Values for this outcome can be negative or positive."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units."@en ;
  skos:broader <urn:era:outcome:indicator:004> .
<urn:era:outcome:150.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Total Cost"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "150.0" ;
  skos:definition "Total production costs."@en ;
  skos:scopeNote "Only use this outcome if it is unclear whether total cost is per asset (e.g. cost per ha of land or animal) or per unit of production (e.g. cost per kg of meat or grain produced). Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the variable cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:150.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Total Cost per Unit Product"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "150.1" ;
  skos:altLabel "Total Cost/Unit"@en ;
  skos:definition "Total production costs per unit of commodity produced. For example USD per kg maize produced or USD per kg of animal weight gained."@en ;
  skos:scopeNote "Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit area, animal or some other asset please use the total cost per asset product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:150.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Total Cost per Asset"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "150.2" ;
  skos:altLabel "Total Cost/Asset"@en ;
  skos:definition "Total production costs per asset. For example USD per ha of farmland or USD per animal."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the variable cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:150.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Total Cost (Unconfirmed)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "150.3" ;
  skos:altLabel "Total Cost (Unc)"@en ;
  skos:definition "Total costs are stated in a publication, but there is insufficient methodological detail about the included costs to confirm this."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the variable cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:151.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Fixed Cost"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "151.0" ;
  skos:definition "Cost that are constant whatever the amount of goods produced, for example land rental costs."@en ;
  skos:scopeNote "Only use this outcome if it is unclear whether total cost is per asset (e.g. cost per ha of land or animal) or per unit of production (e.g. cost per kg of meat or grain produced). Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper record values in the local currency using the ISO 4217 country currency code in the units."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:151.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Fixed Cost per Unit Product"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "151.1" ;
  skos:altLabel "Fixed Cost/Unit"@en ;
  skos:definition "Fixed production costs per unit of commodity produced. For example USD per kg maize produced or USD per kg of animal weight gained."@en ;
  skos:scopeNote "Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit area, animal or some other asset please use the fixed cost per asset product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:151.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Fixed Cost per Asset"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "151.2" ;
  skos:altLabel "Fixed Cost/Asset"@en ;
  skos:definition "Fixed production costs per asset. For example USD per ha of farmland or USD per animal."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the fixed cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:152.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Variable Cost"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "152.0" ;
  skos:altLabel "Var Cost"@en ;
  skos:definition "Costs of inputs (labour, seeds, fertilizers, herbicides, tilling, etc.) that vary with the level of output. The total variable cost can include labour, but record the individual cost of labour using the \"Labour Cost\" subindicator."@en ;
  skos:scopeNote "Only use this outcome if it is unclear whether variable costs are per asset (e.g. cost per ha of land or animal) or per unit of production (e.g. cost per kg of meat or grain produced).Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper record values in the local currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the variable cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:152.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Variable Cost per Unit Product"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "152.2" ;
  skos:altLabel "Var Cost/Unit"@en ;
  skos:definition "Variable production costs per unit of commodity produced. For example USD per kg maize produced or USD per kg of animal weight gained."@en ;
  skos:scopeNote "Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit area, animal or some other asset please use the variable cost per asset product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:152.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Variable Cost per Asset"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "152.3" ;
  skos:altLabel "Var Cost/Asset"@en ;
  skos:definition "Variable production costs per asset. For example USD per ha of farmland or USD per animal."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the variable cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:152.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Labour Cost"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "152.1" ;
  skos:altLabel "Lab Cost"@en ;
  skos:definition "Labour costs only."@en ;
  skos:scopeNote "Only use this outcome if it is unclear whether labour costs are per asset (e.g. cost per ha of land or animal) or per unit of production (e.g. cost per kg of meat or grain produced). Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper record values in the local currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the labour cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:152.4> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Labour Cost per Unit Product"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "152.4" ;
  skos:altLabel "Lab Cost/Unit"@en ;
  skos:definition "Labour costs per unit of commodity produced. For example USD per kg maize produced or USD per kg of animal weight gained."@en ;
  skos:scopeNote "Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units. If costs are given per unit area, animal or some other asset please use the labourcost per asset product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:152.5> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Labour Cost per Asset"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "152.5" ;
  skos:altLabel "Lab Cost/Asset"@en ;
  skos:definition "Labour costs per asset. For example USD per ha of farmland or USD per animal."@en ;
  skos:scopeNote "Please standardize area denominators to ha where possible. Convert local currences to USD (present $ in units) if exchange rates are presented in the paper record values in the local currency using the ISO 4217 country currency code in the units. If costs are given per unit production please use the labour cost per unit product outcome."@en ;
  skos:broader <urn:era:outcome:indicator:005> .
<urn:era:outcome:125.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (GRTC)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.0" ;
  skos:altLabel "BC Ratio (GRTC)"@en ;
  skos:definition "The ratio of gross return to total costs (gross returns/total costs)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:125.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (GRVC)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.1" ;
  skos:altLabel "BC Ratio (GRVC)"@en ;
  skos:definition "The ratio of gross returns to variable costs (gross returns/variable costs)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:125.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (GMVC)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.2" ;
  skos:altLabel "BC Ratio (GMVC)"@en ;
  skos:definition "The ratio of gross margin to variable costs (gross margin/variable costs)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:125.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (NRVC)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.3" ;
  skos:altLabel "BC Ratio (NRVC)"@en ;
  skos:definition "The ratio of net returns to variable costs (net returns/variable costs)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:125.5> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (NRTC)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.5" ;
  skos:altLabel "BC Ratio (NRTC)"@en ;
  skos:definition "The ratio of net returns to variable costs (net returns/total costs)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:125.6> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (GMTC)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.6" ;
  skos:altLabel "BC Ratio (GMTC)"@en ;
  skos:definition "The ratio of gross margin to variable costs (gross margin/total costs)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:125.4> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Benefit Cost Ratio (Unspecified)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "125.4" ;
  skos:altLabel "BC Ratio (Unsp.)"@en ;
  skos:definition "The ratio of benefits to costs when the exact formulation is not specified."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:126.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Cost Benefit Ratio (TCGR)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "126.0" ;
  skos:altLabel "CB Ratio (TCGR)"@en ;
  skos:definition "The ratio of total costs to gross returns (total costs/gross returns)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:126.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Cost Benefit Ratio (VCGR)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "126.1" ;
  skos:altLabel "CB Ratio (VCGR)"@en ;
  skos:definition "The ratio of variable costs to gross returns (variablecosts/gross returns)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:126.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Cost Benefit Ratio (TCNR)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "126.2" ;
  skos:altLabel "CB Ratio (TCNR)"@en ;
  skos:definition "The ratio of variable costs to net returns (variable costs/net returns)."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:130.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Net Present Value"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "130.0" ;
  skos:altLabel "NPV"@en ;
  skos:definition "Net Present Value = the value in the present of a sum of money, in contrast to some future value it will have when it has been invested at compound interest."@en ;
  skos:scopeNote "Convert local currences to USD (present $ in units) if exchange rates are presented in the paper. Record values in non-USD currency using the ISO 4217 country currency code in the units."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:131.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Payback Period"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "131.0" ;
  skos:definition "The period of time required to recoup the funds expended in investment."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:134.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Return on Investment"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "134.0" ;
  skos:altLabel "ROI"@en ;
  skos:definition "Return on investment is the gain or loss relative to the amount invested."@en ;
  skos:scopeNote "This is usually presented as a ratio, please convert any % values to proportions."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:137.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Internal Rate of Return"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "137.0" ;
  skos:altLabel "IRR"@en ;
  skos:definition "Internal Rate of Return is the interest rate at which the net present value of all cash flows equal zero."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:137.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Marginal Rate of Return"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "137.1" ;
  skos:altLabel "MRR"@en ;
  skos:definition "Marginal Rate of Return is the amount of revenue per additional item, divided by marginal costs."@en ;
  skos:broader <urn:era:outcome:indicator:006> .
<urn:era:outcome:203.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Biodiversity"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "203.0" ;
  skos:definition "The species richness or diversity (such as the Shannon or Simpsons index) of a community of organisms within the experimental field. Whether the group of organsims is beneficial, neutral or detrimental to production should be unclear or mixed. One typically reported measure of biodiversity is microbial biomass."@en ;
  skos:broader <urn:era:outcome:indicator:007> .
<urn:era:outcome:268.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Beneficial Organisms"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "268.0" ;
  skos:altLabel "Beneficial Org"@en ;
  skos:definition "Species that provide benefits to crop production (i.e., species provide postive regulating ecosystem services). These can include pollinators (e.g., bees), arbuscular mycorrhizal fungi (AMF) colonisation of crop roots, earthworms or microrganisms involved in nutrient cycling or decomposition. Measures can include their abundance, taxonomic or functional diversity (include details in the Units column)."@en ;
  skos:broader <urn:era:outcome:indicator:007> .
<urn:era:outcome:209.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Pest & Pathogen (Losses)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "209.0" ;
  skos:altLabel "Pest Path (Loss)"@en ;
  skos:definition "Amount of stored crop lost or degraded due to pest/disease."@en ;
  skos:scopeNote "This outcome is for post-harvest storage of products where pests or diseases are damaging the product. It is helpful to record date of storage and sampling date/days after storage for this outcome.\nNote if absolute numbers are given then the amount of crop should be standardized between treatments."@en ;
  skos:broader <urn:era:outcome:indicator:008> .
<urn:era:outcome:209.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Pest & Pathogen (Product Weight)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "209.1" ;
  skos:altLabel "Pest Path (Prod)"@en ;
  skos:definition "Amount of stored crop left after being stored for a period of time."@en ;
  skos:scopeNote "This outcome is for post-harvest storage of products where pests or diseases are damaging the product. For this outcome it is helpful to record the date of storage and sampling date/days after this.\nNote if absolute numbers are given then the amount of crop stored should be standardized between treatments."@en ;
  skos:broader <urn:era:outcome:indicator:008> .
<urn:era:outcome:212.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Pest & Pathogen (Numbers)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "212.0" ;
  skos:altLabel "Pest Path (Num)"@en ;
  skos:definition "The number or amount of pest or pathogen present in a stored product.\n"@en ;
  skos:scopeNote "This outcome is for post-harvest storage of products where pests or diseases are damaging the product. It is helpful to record date of storage and sampling date/days after storage for this outcome.\nDo not use this outcome with change from baseline data, it should be the amount of pest or pathogen on the sampling date."@en ;
  skos:broader <urn:era:outcome:indicator:008> .
<urn:era:outcome:217.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Erosion"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "217.0" ;
  skos:definition "Quantity or extent of soil movement due to water or wind."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:218.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Runoff"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "218.0" ;
  skos:definition "Quantity of water moving off site"@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:223.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Organic Matter"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "223.0" ;
  skos:altLabel "SOM"@en ;
  skos:definition "Concentration or stock of organic matter in soil (SOM)."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:224.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Organic Carbon"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "224.0" ;
  skos:altLabel "SOC"@en ;
  skos:definition "Concentration or stock of organic carbon in soil (SOC)."@en ;
  skos:scopeNote "Please record sampling depth(s) for this outcome"@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:224.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Organic Carbon (Change)"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "224.1" ;
  skos:altLabel "SOC (Change)"@en ;
  skos:definition "Change in soil organic carbon (SOC) over time compared to a baseline condition at the beginning of the experiment."@en ;
  skos:scopeNote "All treatments should have the same baseline conditions, if the baseline is more complex than this then contact Pete. Please record sampling depth(s) for this outcome"@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:226.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Nitrogen"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "226.0" ;
  skos:altLabel "Soil N"@en ;
  skos:definition "Stock or concentration of soil nitrogen exact nature of the nitrogen is not clear (i.e. it is unknown if it is total, available, nitrate or ammonium) or is some other measure of nitrogen."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:226.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Total Nitrogen"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "226.1" ;
  skos:altLabel "Soil TN"@en ;
  skos:definition "Stock or concentration of nitrogen in the soil reported as total nitrogen (TN)."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:226.2> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Available Nitrogen"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "226.2" ;
  skos:altLabel "Soil AN"@en ;
  skos:definition "Stock or concentration of nitrogen in the soil reported as available nitrogen (NO3 + NH4)."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:226.3> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil NO3"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "226.3" ;
  skos:definition "Stock or concentration of nitrogen in the soil reported as nitrate (NO3)."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:226.4> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil NH4"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "226.4" ;
  skos:definition "Stock or concentration of nitrogen in the soil reported as ammonium (NH4)."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:231.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Moisture"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "231.0" ;
  skos:definition "Amount of water in the soil."@en ;
  skos:scopeNote "Do not include: water holding capacity, available water capacity, osmotic potential.\nInclude pressure details in parenthesis after units if presented , e.g. % (0.3 bar). Do not include % change data as compared to a baseline."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:221.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Infiltration Rate"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "221.0" ;
  skos:altLabel "Infiltration"@en ;
  skos:definition "The rate of water movement into the soil."@en ;
  skos:scopeNote "Units should be volume/time."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:228.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Cation Exchange Capacity"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "228.0" ;
  skos:altLabel "CEC"@en ;
  skos:definition "Soil cation exchange capacity."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline. Do not confuse with ECEC (effective CEC) or base saturation."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:228.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Effective Cation Exchange Capacity"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "228.1" ;
  skos:altLabel "ECEC"@en ;
  skos:definition "Soil effective cation exchange capacity."@en ;
  skos:scopeNote "Do not include % change data as compared to a baseline. Do not confuse with CEC or base saturation."@en ;
  skos:broader <urn:era:outcome:indicator:009> .
<urn:era:outcome:270.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Yield Stability"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "270.0" ;
  skos:definition "The variability in yields between seasons or between years."@en ;
  skos:scopeNote "Antilog any logged outcomes, ln(yield stablity) is often reported."@en ;
  skos:broader <urn:era:outcome:indicator:010> .
<urn:era:outcome:236.1> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Animal Survival"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "236.1" ;
  skos:definition "Animal offspring that survive to production."@en ;
  skos:scopeNote "Do not use for plant survival."@en ;
  skos:broader <urn:era:outcome:indicator:011> .
<urn:era:outcome:236.2> a skos:Concept ;
