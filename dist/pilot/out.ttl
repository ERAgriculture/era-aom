<urn:era:outcome:304.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "CO2 Equivalent Emissions"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "304.0" ;
  skos:altLabel "CO2 Equivalent"@en ;
  skos:definition "Emissions over time expressed as CO2 equivalent (e.g. CO2e, CO2eq or CO2-e), often expressed as emissions per area."@en ;
  skos:scopeNote "Note emissions per unit production should be recorded under Emissions Intensity."@en ;
  skos:broader <urn:era:outcome:indicator:015> .
<urn:era:outcome:305.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Methane Emissions"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "305.0" ;
  skos:altLabel "CH4"@en ;
  skos:definition "Flux (emissions or consumption) of methane (CH4) over time."@en ;
  skos:broader <urn:era:outcome:indicator:015> .
<urn:era:outcome:306.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Nitrous Oxide Emissions"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "306.0" ;
  skos:altLabel "NOx"@en ;
  skos:definition "Flux (emissions or consumption) of nitrous oxides (NOx, NO or NO2) over time."@en ;
