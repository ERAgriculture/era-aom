<urn:era:outcome:307.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Carbon Dioxide Emissions"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "307.0" ;
  skos:altLabel "CO2"@en ;
  skos:altLabel "Carbon dioxide emissions"@en ;
  skos:definition "Flux (emissions or consumption)of carbon dioxide (CO2) over time."@en ;
  skos:broader <urn:era:outcome:indicator:015> .
<urn:era:outcome:311.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Emissions Intensity"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "311.0" ;
  skos:definition "Emissions per unit of output (e.g. kg CO2 per kg grain). Cumulative emissions relative to production."@en ;
  skos:scopeNote "Emissions intensity is typically standardized radiative forcing over 100 yr time (CO2eq) for 1 or more gases added together per unit product (kg)."@en ;
  skos:broader <urn:era:outcome:indicator:015> .
<urn:era:outcome:308.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Soil Carbon Stocks"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "308.0" ;
  skos:definition "Quantity in carbon pool or stock as total carbon and reported on soil profiles of at least 30cm or more."@en ;
  skos:scopeNote "Note soil organic carbon or soil organic matter are reported in outcomes under the resilience pillar. Do not record change from baseline here, outcomes should be the value on the sampling date. If change from baseline data are presented consider converting to the values on the sampling date if the baseline line values are available too."@en ;
  skos:broader <urn:era:outcome:indicator:016> .
<urn:era:outcome:309.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Aboveground Carbon Biomass"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "309.0" ;
  skos:altLabel "C Stock (Above)"@en ;
  skos:altLabel "Aboveground Biomass"@en ;
  skos:definition "Stock or amount of carbon in above ground biomass."@en ;
  skos:scopeNote "Do not record change from baseline here, outcomes should be the value on the sampling date. If change from baseline data are presented consider converting to the values on the sampling date if the baseline line values are available too."@en ;
  skos:broader <urn:era:outcome:indicator:016> .
<urn:era:outcome:310.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Belowground Carbon Biomass"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "310.0" ;
  skos:altLabel "C Stock (Below)"@en ;
  skos:definition "Stock or amount of carbon in below ground biomass."@en ;
  skos:scopeNote "Do not record change from baseline here, outcomes should be the value on the sampling date. If change from baseline data are presented consider converting to the values on the sampling date if the baseline line values are available too.\nThis is the amount carbon in soil biomass, if total carbon is presented use the Soil Carbon Stocks outcome."@en ;
  skos:broader <urn:era:outcome:indicator:016> .
<urn:era:outcome:323.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Fuel Use"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "323.0" ;
  skos:definition "Amount of fuel used in a cookstove."@en ;
  skos:broader <urn:era:outcome:indicator:017> .
<urn:era:outcome:320.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Fuel Savings"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "320.0" ;
  skos:definition "Amount of fuel saved by using a cookstove."@en ;
  skos:scopeNote "Note directionality is important here and it should be positive.\nPercentages or proportions should indicate fuel saved, so higher values indicate a better outcome."@en ;
  skos:broader <urn:era:outcome:indicator:018> .
<urn:era:outcome:321.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Cooking Time"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "321.0" ;
  skos:definition "Time taken to cook a particular food."@en ;
  skos:broader <urn:era:outcome:indicator:018> .
<urn:era:outcome:322.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Specific Fuel Use"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "322.0" ;
  skos:definition "Ratio of fuel consumed to food cooked (e.g. kg fuel used/kg food cooked)."@en ;
  skos:scopeNote "Units can be absent as the outcome is a ratio."@en ;
  skos:broader <urn:era:outcome:indicator:018> .
<urn:era:outcome:324.0> a skos:Concept ;
  skos:inScheme <urn:era:scheme:outcome> ;
  skos:prefLabel "Cookstove Emissions"@en ;
  era:conceptType "leaf_outcome" ;
  era:status "active" ;
  skos:notation "324.0" ;
  skos:definition "Emissions of gases (e.g CO) or particulate matter (e.g PM2.5) other than those in the Emissions outcome subpillar (not CO2, Methane, NOx, CO2e)."@en ;
  skos:broader <urn:era:outcome:indicator:018> .
