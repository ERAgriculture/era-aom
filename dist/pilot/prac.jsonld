        {
          "@value": "AgFor Other",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agroforestry practice that does not meet definitions in Agroforestry practice theme.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Please notify ERA team if you use this code.",
