        }
      ],
      "skos:notation": "b40",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Residue Unkn (NoID; NoFate)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Crop residues from an unspecified type of plant are retained in the field, but it is unknown if the residues are mulched or incorporated",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practice should not be used for Agroforestry residues (use the agroforestry theme).",
          "@language": "en"
        }
