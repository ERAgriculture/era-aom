        }
      ],
      "skos:notation": "h7",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Full Irrig",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The crop is fully irrigated.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "A control that can be compared to experimental treatments that apply less water (e.g. deficit irrigation) or this code can be giving to control and treatment where both are irrigated (e.g. rice grown in paddies).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:065"
        }
      ]
