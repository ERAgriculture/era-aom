    {
      "@id": "urn:era:practice:a1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Farmer Managed Natural Regeneration",
          "@language": "en"
        }
      ],
      "skos:notation": "a1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "FMNR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Systematic regrowth of trees or shrubs on agricultural, forest or pasture land. FMNR is used in areas where there are stumps that can coppice or seeds that can germinate. Sometimes called farmer assisted regeneration.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically defined as FMNR or farmer assisted regeneration by author in text.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:001"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Alleycropping (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "a3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Alley (Nfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Intercropping with rows or alleys of nitrogen fixing trees or woody shrubs.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:002"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Alleycropping (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "a4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Alley (nonNfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Intercropping with rows or alleys of trees or woody shrubs that do not fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:002"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a4.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Alleycropping (Mixed)",
          "@language": "en"
        }
      ],
      "skos:notation": "a4.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Alley (Mixed)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Intercropping with rows or alleys of a mixture of trees or woody shrubs of which some but not all fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:002"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a14",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Alleycropping (Unspecified)",
          "@language": "en"
        }
      ],
      "skos:notation": "a14",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Alley (noID)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Intercropping with rows or alleys of trees or woody shrubs where no information about the type of plant is given.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:002"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a8",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Parklands",
          "@language": "en"
        }
      ],
      "skos:notation": "a8",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Intercropping under scattered or regularly planted trees.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically named parklands in the document text. Difference with scattered trees is unclear.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:003"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a8.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Scattered Trees",
          "@language": "en"
        }
      ],
      "skos:notation": "a8.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Unspecified sparse or scattered trees incorporated into croplands, pastures or rangelands.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Difference with Parklands is unclear, other than parklands is not mentioned in the definition.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:003"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a9",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Tree Windbreak",
          "@language": "en"
        }
      ],
      "skos:notation": "a9",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Windbreak",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Barriers of trees or shrubs planted along field boundaries to protect plants against wind.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:004"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a10",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Living Fences or Hedgerows",
          "@language": "en"
        }
      ],
      "skos:notation": "a10",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Hedge",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Living fence and hedges are planted in rows around the edge of the field to reduce the effect of wind or runoff on crops.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Note some early agroforestry papers named alleycropping 'hedgerows', but any form of hedge intercropped within a field should be categorized as alleycropping.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:004"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a11",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Silvopasture",
          "@language": "en"
        }
      ],
      "skos:notation": "a11",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Silvopastoral",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Combination of trees or shrubs with pasture (forage grasses) and livestock",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:005"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a22",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Agrosilvopastoral System",
          "@language": "en"
        }
      ],
      "skos:notation": "a22",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Agrosilvopastoral",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Combination of livestock production systems (pastures) with trees or shrubs and crops.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:005"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a12",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Multistrata Agroforestry",
          "@language": "en"
        }
      ],
      "skos:notation": "a12",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Multistrata",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Multistorey systems agroforestry systems have several spatial strata occupied by different tree (i.e. woody) crops (coffee, tea, cacao, banana etc).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically identified as multistrata in the document text.\n- include two or more vegetation layers and more than one tree species\n- multiple tree crop species and crops (N-fixing legume cover crops)",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:006"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a15",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Tree Prunings Applied (Unspecified)",
          "@language": "en"
        }
      ],
      "skos:notation": "a15",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Prune (noID)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prunings (leaves, branches, etc.) of an unidentified woody plant were retained/returned to the cropping area, but it is unknown if they were mulched or incorporated.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This could be from alleycropping, biomass transfer models or cut-and-carry where prunings come from off the field. It does not include situations where crop processing byproducts such as a oil palm bunch residues or walnut shells are applied to a field, these should be recorded using a regular mulch code.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:007"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a15.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Tree Prunings Mulched (Unspecified)",
          "@language": "en"
        }
      ],
      "skos:notation": "a15.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Prune Mulch (noID)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prunings (leaves, branches, etc.) of an unidentified woody plant were applied to the cropping area as mulch (prunings on the surface).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This could be from alleycropping, biomass transfer models or cut-and-carry where prunings come from off the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:007"
        }
      ]
    },
    {
      "@id": "urn:era:practice:a15.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Tree Prunings Incorporated (Unspecified)",
          "@language": "en"
        }
      ],
      "skos:notation": "a15.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Prune Incorp (noID)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prunings (leaves, branches, etc.) of an unidentified woody plant were applied to the cropping area and incorporated into the soil (e.g., by ploughing).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This could be from alleycropping, biomass transfer models or cut-and-carry where prunings come from off the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:007"
        }
      ]
    },
    {
