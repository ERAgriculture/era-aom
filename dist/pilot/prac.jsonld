      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Inputs Biosolids",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Biosolids are treated and processed sewage sludge applied to fields as a fertilizer. Biosolids do not include industrial waste products, e.g. sugar production waste, ethanol production waste.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:045"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b29.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Compost Substitution",
          "@language": "en"
        }
      ],
      "skos:notation": "b29.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Sub Compost",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compared to a control practice that does not apply compost and does apply inorganic fertilizers, this practice shows reduced, but not eliminated, inorganic fertilizer use (N, P, and/or K)  and application of composted plant material to the field. This represents partial substitution of inorganic inputs with organic inputs. Composts are organic materials which have been piled, moistened, and allowed to undergo biological decomposition.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practice is not available in the ERA data entry process, it added by comparison logic.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:046"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b30.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Manure Substitution",
          "@language": "en"
        }
      ],
      "skos:notation": "b30.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Sub Manure",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compared to a control practice that does not apply animal manures and does apply inorganic fertilizers, this practice shows reduced, but not eliminated, inorganic fertilizer use (N, P, and/or K)  and application of animal manures to the field. This represents partial substitution of inorganic inputs with organic inputs. This does not include biosolids such as sewage which have their own practice codes.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practice is not available in the ERA data entry process, it added by comparison logic.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:046"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b75.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Kraaling or Parcage Substitution",
          "@language": "en"
        }
      ],
      "skos:notation": "b75.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Sub Kraaling",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compared to a control practice that does not use kraaling and does apply inorganic fertilizers, this practice shows reduced, but not eliminated, inorganic fertilizer use (N, P, and/or K)  and use of kraaling. This represents partial substitution of inorganic inputs with organic inputs. Kraaling is a south and west African method of housing animals at night in crop fields to produce manure.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practice is not available in the ERA data entry process, it added by comparison logic.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:046"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b73.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Organic (Other) Substitution",
          "@language": "en"
        }
      ],
      "skos:notation": "b73.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Sub Other Organic",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An organic input that does not match any other category in ERA. Compared to a control practice that does not use this other organic input and does apply inorganic fertilizers, this practice shows reduced, but not eliminated, inorganic fertilizer use (N, P, and/or K)  and use of this other organic input. This represents partial substitution of inorganic inputs with organic inputs.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practice is not available in the ERA data entry process, it added by comparison logic.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:046"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b67.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Biosolids Substitution",
          "@language": "en"
        }
      ],
      "skos:notation": "b67.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Sub Biosolids",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compared to a control practice that does not apply biosolids and does apply inorganic fertilizers, this practice shows reduced, but not eliminated, inorganic fertilizer use (N, P, and/or K)  and application of biosolids to the field. This represents partial substitution of inorganic inputs with organic inputs. Biosolids are treated and processed sewage sludge applied to fields as a fertilizer. Biosolids do not include industrial waste products, e.g. sugar production waste, ethanol production waste.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practice is not available in the ERA data entry process, it added by comparison logic.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:046"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h10",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Conventional input (fertilizer) use",
          "@language": "en"
        }
      ],
      "skos:notation": "h10",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Addition of fertilizer without any specific measurement",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:047"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h10.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "No fertilizers added",
          "@language": "en"
        }
      ],
      "skos:notation": "h10.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "No Fert",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "No inputs of inorganic or organic fertilizer.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "A control for fertilizers addition treatments.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:047"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h10.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Recommend rate of fertilizer",
          "@language": "en"
        }
      ],
      "skos:notation": "h10.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Addition of recommended amount of fertilizer following soil tests. This is to be used when the papers specifically says the recommended rates.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:047"
        }
      ]
    },
    {
      "@id": "urn:era:practice:f1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Harvest Technique",
          "@language": "en"
        }
      ],
      "skos:notation": "f1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Changing the manner in which crops are harvested, for example using a new tool.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:048"
        }
      ]
    },
    {
      "@id": "urn:era:practice:f2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Harvesting Timing",
          "@language": "en"
        }
      ],
      "skos:notation": "f2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Harvest Timing",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Changing the time when crops are harvested, for example moving to piecemeal harvesting from all-at-once or havesting in the morning compared to the heat of the day.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:048"
        }
      ]
    },
    {
      "@id": "urn:era:practice:f3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Drying",
          "@language": "en"
        }
      ],
      "skos:notation": "f3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Drying Improv",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Changing the manner in which crops are dried.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:049"
        }
      ]
    },
    {
      "@id": "urn:era:practice:f4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Chemical Storage",
          "@language": "en"
        }
      ],
      "skos:notation": "f4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Storage Impr Chem",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Using naturally derived or manufactured chemicals such as pesticides or preservatives improve storage. This could include adding actellic dust or fungicide to maize bags or fumigation of stores.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:049"
        }
      ]
    },
    {
      "@id": "urn:era:practice:f5",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Physical Storage",
          "@language": "en"
        }
      ],
      "skos:notation": "f5",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Storage Impr Phys",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Improving the way food stuffs are stored such as Purdue improved crop storage (PICS) bags, use of granaries or improvements to granaries.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:049"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h17",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Traditional harvesting method",
          "@language": "en"
        }
      ],
      "skos:notation": "h17",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Harvest Trad",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Harvesting at usual times or with usual tools.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Control for improved/changed harvesting technique and/or timing.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:050"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h21",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Unimproved Storage Structure",
          "@language": "en"
        }
      ],
      "skos:notation": "h21",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Storage Unimpr Phys",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Storing feeds/seeds in an unimproved manner, such as a traditional granary or storeroom.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Control for Improved Physical Storage.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:051"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h22",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Unimprove or No Preservation Technique",
          "@language": "en"
        }
      ],
      "skos:notation": "h22",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Storage Unimpr Chem",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Typically no method is used to preserve stored foods or the method is considered to be unimproved.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Control for Improved Chemical Storage.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:051"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h30",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Uimproved Drying Technique",
          "@language": "en"
        }
      ],
      "skos:notation": "h30",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Drying Unimpr",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "No or an unimproved drying technique is used to preserve food for storage.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Control for Improved Improved Drying.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:051"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b38",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "No or Zero Tillage",
          "@language": "en"
        }
      ],
      "skos:notation": "b38",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "NoTill",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "No or zero tillage. Planted may use a dibble stick or other direct seeding methods.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "As defined by the author. Zero tillage can be compared to to reduced or conventional tillage.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:052"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b39",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Reduced or Minimum Tillage",
          "@language": "en"
        }
      ],
      "skos:notation": "b39",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "MinTill",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Any tillage practice which reduces, but does not eliminate (no or zero tillage), soil disturbance. Examples include strip tillage, ripping, subsoiling or reducing the number of tillage passes or depth of tillage.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically defined by the author. Reduced tillage can be compared to conventional tillage.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:052"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b26",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Plastic Mulch",
          "@language": "en"
        }
      ],
      "skos:notation": "b26",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Mulching with plastic materials on the soil surface.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:053"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b27",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Mulch (Unspecified Plants)",
          "@language": "en"
        }
      ],
      "skos:notation": "b27",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Mulch (noID)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mulching with plant residues from an unspecified plant type, residues remain on soil surface and are not incorporated or burnt (for example).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Residues can be from the field or brought to the field from outside field boundaries. Residues should not be from agroforestry (see the Tree Pruning Practice under the Agroforestry Theme).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:053"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b27.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Mulch (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b27.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Mulch (Nfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mulching with herbaceous plant residues from a nitrogen fixing (leguminous) plant, residues remain on soil surface and are not incorporated or burnt (for example).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Residues can be from the field or brought to the field from outside field boundaries. Residues should not be from agroforestry (see the Tree Pruning Practice under the Agroforestry Theme).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:053"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b27.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Mulch (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b27.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Mulch (nonNfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mulching with herbaceous plant residues from a non-nitrogen fixing (not leguminous) plant, residues remain on soil surface and are not incorporated or burnt (for example).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Residues can be from the field or brought to the field from outside field boundaries. Residues should not be from agroforestry (see the Tree Pruning Practice under the Agroforestry Theme).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:053"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b27.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Mulch (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b27.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Mulch (Mixed)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mulching with a mixture of herbaceous plant residues from both nitrogen-fixing (leguminous) and non-nitrogen fixing plant, residues remain on soil surface and are not incorporated or burnt (for example).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Residues can be from the field or brought to the field from outside field boundaries. Residues should not be from agroforestry (see the Tree Pruning Practice under the Agroforestry Theme).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:053"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b51",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Mulch (Other Materials)",
          "@language": "en"
        }
      ],
      "skos:notation": "b51",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Mulch (Other)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mulching on the soil surface with organic materials that are not herbaceous plants or plastic. This includes materials like wood shavings.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:053"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b11.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Green Manure (N fixing In Time)",
          "@language": "en"
        }
      ],
      "skos:notation": "b11.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Green Manure (Nfix; Time)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Non-harvested nitrogen fixing (leguminous) plants grown at a different time to harvested crops in system. For example a rotation where in season one a maize main crop is planted (from which grain is harvested) then the next season (or in-between seasons) a green manure is planted (from which no components were harvested for consumption, fibre or sale).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Green manures may be associated with Mulch codes in the Soil Management theme if their residues remain on the surface of the field or residue incorporation subpractices when ploughed into the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:054"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b11.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Green Manure (N fixing In Space)",
          "@language": "en"
        }
      ],
      "skos:notation": "b11.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Green Manure (Nfix; Space)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Non-harvested nitrogen fixing (leguminous) plants grown at the same time as harvested crops. For example a rotation where in season one a maize main crop is planted (from which grain is harvested) then the next season (or in-between seasons) a green manure is planted (from which no components were harvested for consumption, fibre or sale).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Green manures may be associated with Mulch codes in the Soil Management theme if their residues remain on the surface of the field or residue incorporation subpractices when ploughed into the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:054"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b13.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Green Manure (Mixed In Space)",
          "@language": "en"
        }
      ],
      "skos:notation": "b13.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Green Manure (Mixed; Space)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Non-harvested mixed nitrogen fixing (leguminous) and non-nitrogen fixing plants grown at the same time as harvested crops. For example a rotation where in season one a maize main crop is planted (from which grain is harvested) then the next season (or in-between seasons) a green manure is planted (from which no components were harvested for consumption, fibre or sale).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Green manures may be associated with Mulch codes in the Soil Management theme if their residues remain on the surface of the field or residue incorporation subpractices when ploughed into the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:054"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b12.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Green Manure (Non N fixing In Time)",
          "@language": "en"
        }
      ],
      "skos:notation": "b12.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Green Manure (nonNfix; Time)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Non-harvested non-nitrogen fixing (not leguminous) plants grown at a different time to harvested crops in system.For example a rotation where in season one a maize main crop is planted (from which grain is harvested) then the next season (or in-between seasons) a green manure is planted (from which no components were harvested for consumption, fibre or sale).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Green manures may be associated with Mulch codes in the Soil Management theme if their residues remain on the surface of the field or residue incorporation subpractices when ploughed into the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:054"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b12.2",
