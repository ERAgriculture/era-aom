      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Conventional Energy Sources",
          "@language": "en"
        }
      ],
      "skos:notation": "h26",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Cookstove Conv Fuel",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A conventional or normal source of fuel.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "A control for cookstove fuel switching.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:035"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Drought Tolerance",
          "@language": "en"
        }
      ],
      "skos:notation": "b4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Seed Drought",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An improved crop variety bred for potential resistance to drought.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:037"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b5",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Heat Tolerance",
          "@language": "en"
        }
      ],
      "skos:notation": "b5",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Seed Heat",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An improved crop variety bred for potential resistance to heat.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:037"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b6",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Salinity Tolerance",
          "@language": "en"
        }
      ],
      "skos:notation": "b6",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Seed Salt",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An improved crop variety bred for potential resistance to salinity.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:037"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b69",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Seeds",
          "@language": "en"
        }
      ],
      "skos:notation": "b69",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Seed Improv",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An improved crop variety bred for a specific quality other than drought, heat or salinity resistance (e.g. early maturity/short season or improved yields).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:037"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h55",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Unimproved Variety",
          "@language": "en"
        }
      ],
      "skos:notation": "h55",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Unimpr Variety",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A crop variety that has not been improved through intensive crop breeding, for example a farmer's or local variety, or a landrace.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:038"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b35",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Cisterns and Tanks",
          "@language": "en"
        }
      ],
      "skos:notation": "b35",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Water Tanks",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The active collection and storage of water runoff for irrigation purposes.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b33",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Zai Pits",
          "@language": "en"
        }
      ],
      "skos:notation": "b33",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Small pits to capture water. Pits are filled with manure, compost or other nutrient sources before the rainy season. Crops are planted directly into the pits.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Usually associated with a mulch, compost or manure practice.\nTypically identified by the author.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b45",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Stone Rows",
          "@language": "en"
        }
      ],
      "skos:notation": "b45",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Stones piled in rows within a field, typically along contour lines, for the purpose of rainwater harvesting or soil water conservation.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b46",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Grass Strips",
          "@language": "en"
        }
      ],
      "skos:notation": "b46",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Strips of grass within a field or farm created for erosion control, typically they are placed along contour lines.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b47",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Planting Basins",
          "@language": "en"
        }
      ],
      "skos:notation": "b47",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Small planting pits dug to capture water, crops are planted directly into the pits.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically identified by the author.\nIf pits are dug one year and then kept across many seasons, after season one this can be considered a form of reduced tillage.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b68",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Dam",
          "@language": "en"
        }
      ],
      "skos:notation": "b68",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Construction or enhancement of water capture and storage using small dams (e.g. Chaco dams).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b70",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Terraces",
          "@language": "en"
        }
      ],
      "skos:notation": "b70",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "The soil of steeply sloping fields is dug into large steps.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b71.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Bunds",
          "@language": "en"
        }
      ],
      "skos:notation": "b71.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A permanent or semi-permanent ridge of soil or stone typically constructed along a contour that slows water from moving off-site, names include contour bunds, stone bunds, semicircular bunds.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b71.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Ridge & Furrow",
          "@language": "en"
        }
      ],
      "skos:notation": "b71.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "The mounding of soil to allow movement and storage of water in a furrow next to the ridge. Ridges are usually remade each season.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This practices is also a tillage practice, but it's nature depends on the comparison. Sometimes it reduced tillage (e.g., if compared to deep mechanical tillage), sometimes it's conventional practice (e.g. if compared to no-tillage).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b71.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Tied Ridges",
          "@language": "en"
        }
      ],
      "skos:notation": "b71.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Basins are made by digging out shallow furrows along the contour lines of a slope and making ridges on the downside of the furrows. These are “tied” together by slightly lower ridges which are made at regular intervals along the furrows.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "If tied ridges are dug one year and then kept across many seasons, after season one this can be considered a form of reduced tillage, this will typically be identified by the author.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b52",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Microcatchments",
          "@language": "en"
        }
      ],
      "skos:notation": "b52",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Microcatchment is a term for infield water catchment. Negarim microcatchments, for example, are diamond-shaped basins surrounded by small earth bunds with an infiltration pit in the lowest corner of each. Runoff is collected from within the basin and stored in the infiltration pit. Microcatchments are mainly used for growing trees or bushes.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically identified by the author.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b56",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Fanya Juu or Fanya Chini",
          "@language": "en"
        }
      ],
      "skos:notation": "b56",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Fanya Juu or Chini",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A local method used in Tanzania of ditches dug on steep slopes. Fanya juu are terraces constructed by digging ditches and heaping the soil, forming bunds in the upper sides of the ditches. Fanya chini are similar to fanya juus except that the soil is put on the lower side of the contour trench.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Typically identified by the author.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b58",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Trench",
          "@language": "en"
        }
      ],
      "skos:notation": "b58",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A trench dug along the contour lines of a field to capture water. This practice should have no associated bunds or banks with the trench.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:039"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Non CSA",
          "@language": "en"
        }
      ],
      "skos:notation": "h1",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:definition": [
        {
          "@value": "general, other, typically should not be used",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:040"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:h2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Monoculture",
          "@language": "en"
        }
      ],
      "skos:notation": "h2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A single crop is grown in the experimental plot and is invariant over time.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This is the control for an intercropping experiment. Crop varieties may change.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:041"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h38",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Continuous Cropping",
          "@language": "en"
        }
      ],
      "skos:notation": "h38",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:definition": [
        {
          "@value": "A single crop is grown in the experimental plot, this is invariant over the course of the experiment.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This is the control for an intercropping experiment.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:042"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:h18",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Simple Intercrop",
          "@language": "en"
