    },
    {
      "@id": "urn:era:practice:b13",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Alternate Wetting & Drying (AWD)",
          "@language": "en"
        }
      ],
      "skos:notation": "b13",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AWD",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Repeated flooding and draining of paddy rice fields, managed responsively in relation to soil moisture levels.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:024"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b14.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Midseason Drainage",
          "@language": "en"
        }
      ],
      "skos:notation": "b14.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "The paddy rice field is drained during the season, but usually only once.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:024"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b14.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Reduced Water Use in Rice",
          "@language": "en"
        }
      ],
      "skos:notation": "b14.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Reduced Water Use",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Practices that reduce water use in rice that are not alternate wetting & drying (AWD) or midseason drainage. Consider creating a new practice rather than using this code.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:024"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b15",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "System of Rice Intensification (SRI)",
          "@language": "en"
        }
      ],
      "skos:notation": "b15",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "SRI",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "If possible it is best to unpack SRI into its component practices rather than using this practice code. If impossible to disaggregate the SRI practice then use this code.\nSRI is a system package which can include early transplanting (8-12 days), 25cm spacing and alternate wet and dry. Identified by authors.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:024"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b3.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Rotation (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b3.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Rotation (Nfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A crop rotation sequence of two or more legumes.\nA general definition of rotation is that more than one crop is grown in the same location, but across different growing season (diversification in time). Different varieties of the same crop do not count as rotation. A crop is not counted in a rotation sequence when it is obviously a minor intercrop to a main crop which is invariant over time (typically there is standard planting of the main crop from year to year and the intercrop is squeezed in-between the rows of the main crop, for example cowpea planted at a low density inbetween maize rows).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Crops should be grown for harvest and not as cover crop or green manure.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:025"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b3.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Rotation (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b3.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Rotation (nonNfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A crop rotation sequence with two or more non-legumes.\nA general definition of rotation is that more than one crop is grown in the same location, but across different growing season (diversification in time). Different varieties of the same crop do not count as rotation.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Crops should be grown for harvest and not as cover crop or green manure.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:025"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b43",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Rotation (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b43",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Rotation (Mixed)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A crop rotation sequence containing non-leguminous and leguminous crops (e.g. a maize/bean rotation a maize-bean intercrop followed by cassava).\nA general definition of rotation is that more than one crop is grown in the same location, but across different growing season (diversification in time). Different varieties of the same crop do not count as rotation. A crop is not counted in a rotation sequence when it is obviously a minor intercrop to a main crop which is invariant over time (typically there is standard planting of the main crop from year to year and the intercrop is squeezed in-between the rows of the main crop, for example cowpea planted at a low density inbetween maize rows).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Crops should be grown for harvest and not as cover crop or green manure.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:025"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b44",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Complex Rotation",
          "@language": "en"
        }
      ],
      "skos:notation": "b44",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "Rotation (Complex)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A crop rotation sequence with three or more species or rotations with different annual cycles. If intercropping is present in a complex rotation then this should also be captured with an intercropping code. A species is not counted towards a rotation sequence species count when it is obviously a minor intercrop to a main crop which remains invariant (typically there is standard planting of the main crop from year to year and the intercrop is squeezed in-between the rows of the main crop, for example cowpea planted at a low density inbetween maize rows). If it is not clear which crops are main or minor or not then count them all towards a complex rotation total (so an experiement might have maize one year, then the next year some maize rows are replaced with beans, in this case the beans are counted as a rotation crop and the number of species is two).\nA general definition of rotation is that more than one crop is grown in the same location, but across different growing season (diversification in time). Different varieties of the same crop do not count as rotation. Crops should be grown for harvest and not as cover crop or green manure.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:026"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b31",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Intercrop Rotation",
          "@language": "en"
        }
      ],
      "skos:notation": "b31",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "Rotation (Int Only)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Rotation where a main crop remains the same between seasons (no change in spatial location or crop identity), but the minor intercrop is not always present. If the same crop is intercropped throughout the sequence (e.g. Maize-Beans/Maize/Maize-Beans) then this requires a Partial Intercropping code (b50.1, b50.2 or b50.3) or if the intercrop changes throughout the sequence (e.g. Maize-Beans/Maize-Millet/Maize-Beans) this requires a Complex Intercrop Rotation code (b57). If the intercrop is mostly one crop for a long sequence, but rarely something else is planted, we still consider this to be relevant to the Partial Intercropping code.\nA general definition of rotation is that more than one crop is grown in the same location, but across different growing season (diversification in time). Different varieties of the same crop do not count as rotation. A crop is not counted in a rotation sequence when it is obviously a minor intercrop to a main crop which is invariant over time (typically there is standard planting of the main crop from year to year and the intercrop is squeezed in-between the rows of the main crop, for example cowpea planted at a low density inbetween maize rows). Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:026"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b48.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Double Cropping (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b48.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A double cropping system where two different crops are planting sequentially within the same growing season. Some crops fix nitrogen others do not.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:027"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b48.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Double Cropping (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b48.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A double cropping system where two different crops are planting sequentially within the same growing season. No crops fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:027"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b48.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Double Cropping (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b48.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A double cropping system where two different crops are planting sequentially within the same growing season. All crops fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:027"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b48.4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Double Cropping (Monocrop)",
          "@language": "en"
        }
      ],
      "skos:notation": "b48.4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A double cropping system where the same crop is planted more than once and sequentially within the same growing season.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:027"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b49.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Sequential Intercropping (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b49.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "An intercropping and double cropping  system where two crops are planted together at the start of the season, then one is harvested and another crop planted whilst the non-harvested crop is growing (all within the same season). Some crops fix nitrogen others does not.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b49.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Sequential Intercropping (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b49.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "An intercropping and double cropping intercropping system where two crops are planted together at the start of the season, then one is harvested and another crop planted whilst the non-harvested crop is growing (all within the same season). No crops fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b49.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Sequential Intercropping (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b49.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "An intercropping and double cropping system where two crops are planted together at the start of the season, then one is harvested and another crop planted whilst the non-harvested crop is growing (all within the same season). All crops fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b61.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Relay Intercropping (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b61.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A crop is planted and then another is planted with that crop, but at a later date within the same season. Some crops fixes nitrogen the others does not.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b61.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Relay Intercropping (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b61.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A crop is planted and then another is planted with that crop, but at a later date within the same season.  No crops fixes nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b61.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Relay Intercropping (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b61.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A crop is planted and then another is planted with that crop, but at a later date within the same season. All crop fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b13.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Relay Green Manure (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b13.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A crop is planted and then a green manure is planted with that crop, but at a later date within the same season. Some crops fixes nitrogen the others does not. A green manure is usually planted to improve soil quality and it should not be harvested crop.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:029"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b12.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Relay Green Manure (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b12.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A crop is planted and then a green manure is planted with that crop, but at a later date within the same season. No crops fixes nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:029"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b11.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Relay Green Manure (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b11.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "A crop is planted and then a green manure is planted with that crop, but at a later date within the same season. All crop fix nitrogen.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:029"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b25",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Intercrop (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b25",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Mixed)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system with a legume and non-legume.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:030"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b50.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Intercrop (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b50.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Intercrop (nonNfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system with two non-legumes.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:030"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b50.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Intercrop (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b50.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Nfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system with two or more legumes (edible or marketable).\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:030"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b50.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Complex Intercrop",
          "@language": "en"
        }
      ],
      "skos:notation": "b50.3",
      "era:conceptType": "leaf_practice",
      "era:status": "unknown",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Complex)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system that is too complex to descirbe using existing ERA definitions. Typically involving multiple intercropping practices at the same time. Please use the notes to descirbe this practice.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b50.4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Intercrop (Unspecified)",
          "@language": "en"
        }
      ],
      "skos:notation": "b50.4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Unsp.)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system is present, but no details on composition are available.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Only use this practice where there are no details presented about an intercropping paper. All we know is that intercropping was present.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:030"
        }
      ]
    },
    {
      "@id": "urn:era:practice:b55.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Partial Intercrop (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b55.1",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Part; Mixed)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system with a legume and non-legume where intercropping is not present every season (spatial diversification that is variable over time). For example a repeating sequence of Maize followed by a Maize-Cowpea intercrop, this would also get an intercrop rotation code.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b55.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Partial Intercrop (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b55.2",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Part; nonNfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system with two non-legume crops where intercropping is not present every season (spatial diversification that is variable over time). For example a repeating sequence of Maize followed by a Maize-Cowpea intercrop, this would also get an intercrop rotation code.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b55.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Partial Intercrop (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b55.3",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Part; Nfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intercropping system with two legume crops where intercropping is not present every season (spatial diversification that is variable over time). For example a repeating sequence of Maize followed by a Maize-Cowpea intercrop, this would also get an intercrop rotation code.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b57",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Complex Intercrop Rotation",
          "@language": "en"
        }
      ],
      "skos:notation": "b57",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:altLabel": [
        {
          "@value": "Intercrop (Rot; Complex)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "There is a main crop (there is no change in spatial location or crop identity) and intercrop (minor) crop sequence , but the nature of the main-intercrop pairing changes between seasons (e.g. Maize-Beans/Maize-Millet/Maize-Beans) , this can be thought of as rotation in the intercrop (minor crop). If the intercrop is mostly one crop for a long sequence, but rarely something else is planted, we still consider this to be relevant to the Partial Intercropping code.\nIntercropping is where more than one crop is grown at the same time in the same area of management (typically a single field), this is diversification in space rather than diversification in time. Crops should be grown for harvest and not as cover crop or green manure (if the latter see the green manure practices).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:028"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:b59",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Intercropping or Rotation (N fixing & Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "b59",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Int or Rot (Mixed)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only use this practices where a paper states that legume intercropping or rotation was used, but the outcomes do not distinguish between the two.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This outcome will typically relate to farmer trials or surveys.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:031"
        }
      ]
    },
    {
      "@id": "urn:era:practice:c1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Biogas",
          "@language": "en"
        }
      ],
      "skos:notation": "c1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Biogas Prod",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Biogas production from from anaerobic biodigesters.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "The comparison for this practice can be wood fuel or charcoal production as traditional energy sources (the outcomes would be cost, labor, fuel use, cooking time, etc.).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:032"
        }
      ]
    },
    {
      "@id": "urn:era:practice:c4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Biofertilizer",
          "@language": "en"
        }
      ],
      "skos:notation": "c4",
      "era:conceptType": "leaf_practice",
      "era:status": "deprecated",
      "skos:definition": [
        {
          "@value": "Fertilizer (biofertilizer) produced using a biodigestor slurry.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "USE COMPOST CODE b29",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:033"
        }
      ],
      "owl:deprecated": true
    },
    {
      "@id": "urn:era:practice:c3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Biogas Switching",
          "@language": "en"
        }
      ],
      "skos:notation": "c3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Biogas Switch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Switching of biodigestors biomass feedstocks.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Biodigestor papers only.",
          "@language": "en"
        }
      ],
      "skos:broader": [
