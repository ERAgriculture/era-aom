          "@value": "Fallow Unimpr",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A fallowing practice where the land is left unmanaged between production periods.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This is the control practice for improved fallows.",
          "@language": "en"
        }
