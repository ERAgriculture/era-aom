    {
      "@id": "urn:era:practice:a18",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Tree Pruning (Fate Unknown)",
          "@language": "en"
        }
      ],
      "skos:notation": "a18",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "AgFor Prune (Unknown)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The cutting or coppicing of woody agroforestry species, generally to reduce competition or shading with intercrops, but the fate of the residues is unknown (it is unclear if was applied or removed).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "This could be from alleycropping, biomass transfer models or cut-and-carry where prunings come from off the field.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:007"
        }
      ]
    },
