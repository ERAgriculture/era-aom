          "@id": "urn:era:practice:practice:032"
        }
      ]
    },
    {
      "@id": "urn:era:practice:c2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Cookstoves",
          "@language": "en"
        }
      ],
      "skos:notation": "c2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Cookstove Improv",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Improved cookstove designed to burn biomass fuels in a cleaner and more efficient manner than conventional practice (e.g., traditional three-stone fires).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:034"
        }
      ]
    },
    {
      "@id": "urn:era:practice:c5",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Cookstove Switching",
          "@language": "en"
        }
      ],
      "skos:notation": "c5",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Cookstove Switch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Switching cookstove biomass feedstocks.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Cooking fuel studies only. Changing the source of fuel doesn't count (e.g. unsustainable wood from source A vs sustianable fuel from source B).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:034"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h14",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Unimproved Stove Technology",
          "@language": "en"
        }
      ],
      "skos:notation": "h14",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Cookstove Unimpr",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Use of traditional stoves for burning biomass fuels lile traditional three-stone; a control for improved cookstoves",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "A control for an improved cookstove.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:035"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h15",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Conventional Biomass Feedstocks",
          "@language": "en"
        }
      ],
      "skos:notation": "h15",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Biomass Feed Conv",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Use of normal/usual feedstocks in a biomass digestor.",
          "@language": "en"
        }
      ],
      "skos:broader": [
