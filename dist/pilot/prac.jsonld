          "@value": "pH",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Application of lime (e.g., dolomite) or forms of calcium (e.g. oyster shells) to the field to raise the pH.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:056"
        }
