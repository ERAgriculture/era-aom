        }
      ]
    },
    {
      "@id": "urn:era:practice:d17.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Crop Fodders (Added)",
          "@language": "en"
        }
      ],
      "skos:notation": "d17.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Crop (Add)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feeds added to animal diets that come from non-woody crops not usually grown for fodder, but for another purpose (e.g. consumption). These can be crop grain. field residues (for example maize stalks left over once the grain component has been harvested) and or processing residues (for example the maize bran produced as a byproduct of milling flour). Soyabeans fit in this category as they are grown for human consumption and livestock feed.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Feeds are added compared to a control practice (basal diet) that does not contain items which would gain the same ERA classfication. Control diets are often hay ad libitum or hay ad libitum + maize stover.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:010"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d17.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Non Crop Fodders (Added)",
          "@language": "en"
        }
      ],
      "skos:notation": "d17.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed NonCrop (Add)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feeds added to animal diets that are non-woody crops grown primarily for fodder (e.g., alfafa or clover grown to feed to cattle) or non-woody plants harvested from non-cropped areas (e.g., forage grasses such as napier grass grown to stabilize terraces, cactus harvested from boundary fences, wild growing plants in wayside or fallows, algae, etc.).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Feeds are added compared to a control practice (basal diet) that does not contain items which would gain the same ERA classfication. Control diets are often hay ad libitum or hay ad libitum + maize stover.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:010"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d17.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Agroforestry Fodders (Added)",
          "@language": "en"
        }
      ],
      "skos:notation": "d17.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed AgFor (Add)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feeds added to animal diets that are from agroforestry shrub or tree fodders or other woody plants.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Feeds are added compared to a control practice (basal diet) that does not contain items which would gain the same ERA classfication. Control diets are often hay ad libitum or hay ad libitum + maize stover.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:010"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d17.4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Animal Manures (Added)",
          "@language": "en"
        }
      ],
      "skos:notation": "d17.4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Manure (Add)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feeds added to animal diets that are animal manures.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Feeds are added compared to a control practice (basal diet) that does not contain items which would gain the same ERA classfication. Control diets are often hay ad libitum or hay ad libitum + maize stover.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:010"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d17.5",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Other Feed (Added)",
          "@language": "en"
        }
      ],
      "skos:notation": "d17.5",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Other (Add)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feeds added to animal diets that are non-plant or non-manure based materials. These typically include materials that are the by-product of animal processing (e.g., bone meal or fish meal).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Feeds are added compared to a control practice (basal diet) that does not contain items which would gain the same ERA classfication. Control diets are often hay ad libitum or hay ad libitum + maize stover.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:010"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d18.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Crop Fodders (Substituted)",
          "@language": "en"
        }
      ],
      "skos:notation": "d18.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Crop (Sub)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Components of a basal diet fully or partially substituted for residues from crops not primarily grown for fodder, but for another purpose (e.g. consumption). These can be field residues (for example maize stalks left over once the grain component has been harvested) and or processing residues (for example the maize bran produced as a byproduct of milling flour).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Substitutions are typically defined by the author. Usually they are looking to substitute a conventional (e.g. purchased diet) with cheaper or more sustainable alternatives.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:011"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d18.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Non Crop Fodders (Substituted)",
          "@language": "en"
        }
      ],
      "skos:notation": "d18.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed NonCrop (Sub)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Components of a basal diet fully or partially substituted for non-woody crops grown primarily for fodder (e.g., alfafa or clover grown to feed to cattle) or non-woody plants harvested from non-cropped areas (e.g., forage grasses such as napier grass grown to stabilize terraces, cactus harvested from boundary fences, wild growing plants in wayside or fallows, algae, etc.). Feeds are added compared to a base practice control such as hay ad libitum only.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Substitutions are typically defined by the author. Usually they are looking to substitute a conventional (e.g. purchased diet) with cheaper or more sustainable alternatives.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:011"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d18.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Agroforestry Fodders (Substituted)",
          "@language": "en"
        }
      ],
      "skos:notation": "d18.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed AgFor (Sub)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Components of a basal diet fully or partially substituted for agroforestry shrub or tree fodders (woody plants).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Substitutions are typically defined by the author. Usually they are looking to substitute a conventional (e.g. purchased diet) with cheaper or more sustainable alternatives.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:011"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d18.4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Animal Manures (Substituted)",
          "@language": "en"
        }
      ],
      "skos:notation": "d18.4",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Manure (Sub)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Components of a basal diet fully or partially substituted for animal manures.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Substitutions are typically defined by the author. Usually they are looking to substitute a conventional (e.g. purchased diet) with cheaper or more sustainable alternatives.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:011"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d18.5",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Other Feed (Substituted)",
          "@language": "en"
        }
      ],
      "skos:notation": "d18.5",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Byproducts (Sub)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Components of a basal diet fully or partially substituted with non-plant and non-manure based materials. These typically include materials for the by-product of animal processing (e.g., bone meal or fish meal).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "Substitutions are typically defined by the author. Usually they are looking to substitute a conventional (e.g. purchased diet) with cheaper or more sustainable alternatives.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:011"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d22.1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Chemically Processed Feed",
          "@language": "en"
        }
      ],
      "skos:notation": "d22.1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Chem Process",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fodders that have been chemically processed, for example urea-treated stover or fermented fodders. Silage is a type of fodder made from green foliage crops which have been preserved by acidification, achieved through fermentation.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:012"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d22.2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Mechanically Processed Feed",
          "@language": "en"
        }
      ],
      "skos:notation": "d22.2",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Mech Process",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fodders or plant wastes that have been mechanically processed, for example chopped or pelletted grasses or ground orange peel.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:012"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d22.3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Concentrated Feed",
          "@language": "en"
        }
      ],
      "skos:notation": "d22.3",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Feed Concentrates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Non-forage feeds rich in energy and protein. Concentrates include feeds such as maize bran, cotton seed cake, molasses, fish meal and bean cake. Non-forage feeds may use energy or protein rich part plants such as seeds, whereas forage feeds are mainly plant leaves and stems.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:012"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d9",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Breeds",
          "@language": "en"
        }
      ],
      "skos:notation": "d9",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Breed Impr",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The use of improved animal breeds, these are animals bred for specific traits usually productivity (typically breeds exotic to Africa like Friesen, Holstein or Jersey cows).",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:013"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d10",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Hybridization or Cross Breeding",
          "@language": "en"
        }
      ],
      "skos:notation": "d10",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Breed Hybrid",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The use of animal cross breeds produced by the mating (hybridization) of individuals of different breeds, varieties, or species.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:013"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d13",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Manure Collection",
          "@language": "en"
        }
      ],
      "skos:notation": "d13",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Techniques to collect manure, e.g, increased frequency of collection and removal from the kraal.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:014"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d14",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Manure Storage",
          "@language": "en"
        }
      ],
      "skos:notation": "d14",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "Manure storage techniques such as heaps, pits or dry lots.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:014"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d15",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Manure Treatment",
          "@language": "en"
        }
      ],
      "skos:notation": "d15",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Manure Treat",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Techniques for treatment of manure.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:014"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d16",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Rotational Grazing",
          "@language": "en"
        }
      ],
      "skos:notation": "d16",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Grazing Rotation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The movement of animals between different paddocks at intervals.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:015"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d11",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Pasture (N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "d11",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Pasture Impr (Nfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The planting of pastures with leguminous forages.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:015"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d12",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Improved Pasture (Non N fixing)",
          "@language": "en"
        }
      ],
      "skos:notation": "d12",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Pasture Impr (nonNfix)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The planting of pastures with non-leguminous forages.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:015"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d19",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Controlled Grazing",
          "@language": "en"
        }
      ],
      "skos:notation": "d19",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Grazing Controlled",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The restriction of animal movement within pastures. Controlled grazing is known by many names, such as rotational grazing, rotational stocking, intensive grazing and strip grazing. Typically a large pasture is subdivided into several smaller pastures (paddocks) by cross fencing and animals stocked in one of the paddocks. When the forage has been removed, cattle are rotated to the next paddock.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:015"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d20",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut & Carry",
          "@language": "en"
        }
      ],
      "skos:notation": "d20",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:altLabel": [
        {
          "@value": "Grazing Cut & Carry",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A system where animals are confined and feed is brought to them, also known as zero grazing.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:015"
        }
      ]
    },
    {
      "@id": "urn:era:practice:d1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Aquasilviculture",
          "@language": "en"
        }
      ],
      "skos:notation": "d1",
      "era:conceptType": "leaf_practice",
      "era:status": "active",
      "skos:definition": [
        {
          "@value": "An aquaculture practice in combination with a sylviculture practice in close spatial proximity. The classic example of this practice is fish or crustacean farming in mangroves, to conserve or restore mangrove trees and produce food.",
          "@language": "en"
        }
      ],
      "skos:broader": [
        {
          "@id": "urn:era:practice:practice:016"
        }
      ]
    },
    {
      "@id": "urn:era:practice:h60",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:era:scheme:practice"
      },
      "skos:prefLabel": [
        {
          "@value": "Basal or Conventional Diet",
          "@language": "en"
