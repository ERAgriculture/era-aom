# ERA-AOM persistent namespace
# Maintainer: Pete Steward and ERA-AOM maintainers (GitHub: peetmate)
Options +FollowSymLinks
Options -MultiViews
RewriteEngine On
<IfModule mod_headers.c>
  Header always set Vary "Accept"
</IfModule>

RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^(?:livestock/.*)?$ https://github.com/ERAgriculture/era-aom/releases/download/2026.1/aom-livestock.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^(?:livestock/.*)?$ https://github.com/ERAgriculture/era-aom/releases/download/2026.1/aom-livestock.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^(?:livestock/.*)?$ https://github.com/ERAgriculture/era-aom/releases/download/2026.1/aom-livestock.rdf [R=303,L]

RewriteRule ^livestock/(.+)$ https://vocab.era.cgiar.org/livestock/en/page/$1 [R=303,NE,L]
RewriteRule ^(?:livestock)?/?$ https://vocab.era.cgiar.org/livestock/en/ [R=303,NE,L]
RewriteRule ^release/2026.1/?$ https://github.com/ERAgriculture/era-aom/releases/download/2026.1/manifest.json [R=303,NE,L]
RewriteRule ^ https://github.com/ERAgriculture/era-aom [R=303,NE,L]
