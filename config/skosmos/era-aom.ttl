@prefix dc: <http://purl.org/dc/terms/> .
@prefix mdrtype: <http://publications.europa.eu/resource/authority/dataset-type/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosmos: <http://purl.org/net/skosmos#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix aom: <https://w3id.org/era-aom/schema/> .
@prefix aomcfg: <https://w3id.org/era-aom/config/> .

aomcfg:configuration a skosmos:Configuration ;
  skosmos:sparqlEndpoint <http://fuseki-cache:80/skosmos/sparql> ;
  skosmos:sparqlDialect "JenaText" ;
  skosmos:sparqlCollationEnabled false ;
  skosmos:sparqlTimeout 20 ;
  skosmos:httpTimeout 5 ;
  skosmos:serviceName "ERA-AOM Vocabulary Browser" ;
  skosmos:customCss "resource/css/era-aom.css" ;
  skosmos:languages ( [ rdfs:label "en" ; rdf:value "en_GB.utf8" ] ) ;
  skosmos:searchResultsSize 20 ;
  skosmos:transitiveLimit 1000 ;
  skosmos:rdfListItemsLimit 1000 ;
  skosmos:templateCache "/tmp/skosmos-template-cache" ;
  skosmos:feedbackAddress "" ;
  skosmos:feedbackSender "" ;
  skosmos:feedbackEnvelopeSender "" ;
  skosmos:globalPlugins () .

aomcfg:livestock a skosmos:Vocabulary, void:Dataset ;
  dc:title "Agriculture Ontology for Meta-analysis — Livestock"@en ;
  dc:publisher "Alliance of Bioversity International and CIAT"@en ;
  dc:type mdrtype:ONTOLOGY ;
  void:uriSpace "https://w3id.org/era-aom/livestock/" ;
  skosmos:language "en" ;
  skosmos:defaultLanguage "en" ;
  skosmos:showTopConcepts true ;
  skosmos:showStatistics true ;
  skosmos:loadExternalResources false ;
  skosmos:propertyOrder aomcfg:eraPropertyOrder ;
  skosmos:propertyLabelOverride [
    skosmos:property skos:altLabel ;
    rdfs:label "Synonyms"@en ;
    rdfs:comment "Alternative names that retrieve this same concept."@en
  ] ;
  skosmos:propertyLabelOverride [
    skosmos:property skos:relatedMatch ;
    rdfs:label "Related external resources"@en
  ] ;
  skosmos:propertyLabelOverride [
    skosmos:property skos:exactMatch ;
    rdfs:label "Equivalent external concepts"@en
  ] ;
  skosmos:propertyLabelOverride [
    skosmos:property skos:narrowMatch ;
    rdfs:label "Narrower external resources"@en
  ] ;
  skosmos:shortName "ERA-AOM Livestock" ;
  void:sparqlEndpoint <http://fuseki-cache:80/skosmos/sparql> ;
  skosmos:sparqlGraph <https://w3id.org/era-aom/graph/livestock> ;
  skosmos:mainConceptScheme <https://w3id.org/era-aom/scheme/livestock-v2> .

# Skosmos' default order suppresses domain properties. Keep familiar SKOS fields,
# then expose ERA-AOM material facets as first-class, navigable relationships.
aomcfg:eraPropertyOrder rdf:value (
  rdf:type dc:isReplacedBy skos:definition skos:broader skos:narrower
  skos:related skos:altLabel skos:exactMatch skos:closeMatch
  skos:broadMatch skos:narrowMatch skos:relatedMatch
  aom:sourceTaxon aom:ingredientSource aom:materialComponent aom:ingredientPart
  aom:materialIntegrity aom:presentationForm aom:bulkConsistency aom:moistureCondition
  aom:processingMethod aom:mayResultInPresentationForm aom:mayResultInMoistureCondition
  aom:feedProductType aom:compositionState aom:productRole aom:primaryConstituent
  aom:ingredientConstituent
  skos:note skos:scopeNote skos:historyNote rdfs:comment dc:source
) .
