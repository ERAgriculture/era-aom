@prefix aom: <urn:era-aom:schema:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aom:FeedMaterialShape a sh:NodeShape ;
  sh:targetClass aom:FeedMaterial ;
  sh:property [
    sh:path aom:ingredientName ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [ sh:path aom:sourceTaxon ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:legacyComponentDescriptor ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path aom:materialComponent ; sh:class aom:FeedMaterialComponent ] ;
  sh:property [ sh:path aom:ingredientPart ; sh:class aom:IngredientPartCategory ] ;
  sh:property [ sh:path aom:physicalForm ; sh:class aom:IngredientPhysicalForm ] ;
  sh:property [ sh:path aom:presentationForm ; sh:class aom:IngredientPresentationForm ] ;
  sh:property [ sh:path aom:bulkConsistency ; sh:class aom:IngredientBulkConsistency ] ;
  sh:property [ sh:path aom:moistureCondition ; sh:class aom:IngredientMoistureCondition ] ;
  sh:property [ sh:path aom:materialIntegrity ; sh:class aom:MaterialIntegrity ] ;
  sh:property [ sh:path aom:feedProductType ; sh:class aom:FeedProductType ] ;
  sh:property [ sh:path aom:compositionState ; sh:class aom:CompositionState ] ;
  sh:property [ sh:path aom:processingMethod ; sh:class aom:ProcessingMethod ] ;
  sh:property [ sh:path aom:productRole ; sh:class aom:ProductRole ] ;
  sh:property [ sh:path aom:ingredientConstituent ; sh:class aom:IngredientConstituent ] ;
  sh:property [ sh:path aom:ingredientSource ; sh:class aom:IngredientSourceCategory ] .

aom:IngredientComponentShape a sh:NodeShape ;
  sh:targetClass aom:IngredientComponent ;
  sh:property [
    sh:path aom:ingredientMaterial ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class aom:FeedMaterial
  ] ;
  sh:property [
    sh:path aom:ingredientProportion ;
    sh:maxCount 1 ;
    sh:class qudt:QuantityValue ;
    sh:node aom:QuantityValueShape
  ] .

aom:QuantitativeObservationShape a sh:NodeShape ;
  sh:targetClass aom:QuantitativeObservation ;
  sh:property [
    sh:path sosa:observedProperty ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path sosa:hasResult ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class qudt:QuantityValue ;
    sh:node aom:QuantityValueShape
  ] .

aom:QuantityValueShape a sh:NodeShape ;
  sh:class qudt:QuantityValue ;
  sh:property [
    sh:path qudt:numericValue ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] ;
  sh:property [
    sh:path qudt:unit ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] .

aom:SemanticBindingShape a sh:NodeShape ;
  sh:targetClass aom:SemanticBinding ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path aom:legacyConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:bindingKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "property" "quantified_component" "observable_property" ) ] ;
  sh:property [ sh:path aom:targetClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:targetProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:valueClass ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:quantityKind ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:unitRequirement ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "required" "not_applicable" ) ] ;
  sh:property [ sh:path aom:compatibilityPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path aom:bindingStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "approved" ) ] .

aom:SemanticValueBindingShape a sh:NodeShape ;
  sh:targetClass aom:SemanticValueBinding ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path aom:valueTargetProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:sourceValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path aom:bindingAction ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "map_to_existing" "map_to_external" "decompose_to_existing" "hold_ambiguous" "hold_non_taxon" ) ] ;
  sh:property [ sh:path aom:valueTargetConcept ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:targetValueClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path aom:valueBindingStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "approved" ) ] ;
  sh:or (
    [ sh:property [ sh:path aom:bindingAction ; sh:in ( "map_to_existing" "map_to_external" "decompose_to_existing" ) ] ;
      sh:property [ sh:path aom:valueTargetConcept ; sh:minCount 1 ; sh:maxCount 1 ] ]
    [ sh:property [ sh:path aom:bindingAction ; sh:in ( "hold_ambiguous" "hold_non_taxon" ) ] ;
      sh:property [ sh:path aom:valueTargetConcept ; sh:maxCount 0 ] ]
  ) .
