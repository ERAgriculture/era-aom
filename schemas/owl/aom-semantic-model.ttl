@prefix aom: <urn:era-aom:schema:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:era-aom:schema> a owl:Ontology ;
  dcterms:title "AOM semantic model"@en ;
  dcterms:description "OWL model separating AOM knowledge-organization concepts from agricultural observations, feed-material records, quantities, and governance provenance."@en ;
  owl:versionInfo "design-1" .

aom:Module a owl:Class ; rdfs:label "module"@en .
aom:MappingAssertion a owl:Class ; rdfs:label "mapping assertion"@en .
aom:ChangeProposal a owl:Class ; rdfs:label "change proposal"@en .
aom:Release a owl:Class ; rdfs:label "release"@en .
aom:Evidence a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "evidence"@en .
aom:Reviewer a owl:Class ; rdfs:subClassOf prov:Agent ; rdfs:label "reviewer"@en .

aom:FeedMaterial a owl:Class ;
  rdfs:label "feed material"@en ;
  rdfs:comment "A material used or evaluated as feed. Source organism, part, processing method, and economic product role are modeled as facets."@en .
aom:FeedFormulation a owl:Class ; rdfs:label "feed formulation"@en .
aom:IngredientComponent a owl:Class ;
  rdfs:label "ingredient component"@en ;
  rdfs:comment "A feed material used in a formulation, optionally with a quantitative proportion."@en .
aom:QuantitativeObservation a owl:Class ;
  rdfs:subClassOf sosa:Observation ;
  rdfs:label "quantitative observation"@en .
aom:ProductRole a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "product role"@en .
aom:ParityStatus a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "parity status"@en .
aom:GestationalStage a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "gestational stage"@en .

aom:inModule a owl:ObjectProperty ; rdfs:range aom:Module .
aom:supportedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:range aom:Evidence .
aom:reviewedBy a owl:ObjectProperty ; rdfs:range aom:Reviewer .
aom:releasedIn a owl:ObjectProperty ; rdfs:range aom:Release .
aom:hasIngredientComponent a owl:ObjectProperty ;
  rdfs:domain aom:FeedFormulation ; rdfs:range aom:IngredientComponent .
aom:ingredientMaterial a owl:ObjectProperty ;
  rdfs:domain aom:IngredientComponent ; rdfs:range aom:FeedMaterial .
aom:ingredientProportion a owl:ObjectProperty ;
  rdfs:domain aom:IngredientComponent ; rdfs:range qudt:QuantityValue .
aom:sourceTaxon a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ;
  rdfs:comment "Links feed material to a reviewed taxon IRI; does not imply SKOS identity."@en .
aom:ingredientPart a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range skos:Concept .
aom:processingMethod a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range skos:Concept .
aom:productRole a owl:ObjectProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range aom:ProductRole .
aom:ingredientSource a owl:ObjectProperty ; rdfs:domain aom:FeedMaterial .
aom:ingredientName a owl:DatatypeProperty ;
  rdfs:domain aom:FeedMaterial ; rdfs:range xsd:string .
